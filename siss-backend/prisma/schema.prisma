/// Registro de trazabilidad de acciones críticas realizadas en el sistema
model AuditLog {
  /// Identificador único
  id         Int      @id @default(autoincrement())
  /// ID del usuario que realizó la acción
  usuarioId  Int?
  /// Tipo de operación (CREATE, UPDATE, DELETE, LOGIN)
  accion     String   @db.VarChar(50)
  /// Nombre de la tabla o entidad afectada
  entidad    String   @db.VarChar(100)
  /// ID del registro específico afectado
  entidadId  Int?
  /// Descripción detallada del cambio o error
  detalle    String?  @db.Text
  /// Dirección IP del cliente
  ip         String?  @db.VarChar(45)
  /// Tiempo de respuesta del servidor en milisegundos
  duracionMs Int?
  /// Fecha y hora exacta del evento
  timestamp  DateTime @default(now())

  /// Relación con el usuario (si aplica)
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([timestamp])
  @@index([usuarioId])
  @@map("audit_logs")
}

/// Configuración global de variables de operación del sistema
model ParametroSistema {
  /// Identificador único
  id            Int      @id @default(autoincrement())
  /// Nombre único de la variable (ej: TIEMPO_SESION)
  clave         String   @unique @db.VarChar(50)
  /// Valor asignado a la configuración
  valor         String   @db.VarChar(500)
  /// Explicación del impacto del parámetro en el sistema
  descripcion   String?  @db.VarChar(200)
  /// Fecha de creación inicial
  creadoEn      DateTime @default(now())
  /// Fecha de última actualización
  actualizadoEn DateTime @updatedAt

  @@map("parametros_sistema")
}

/// Registro de la entrega física de medicamentos al paciente
model Dispensacion {
  /// Identificador único
  id                Int      @id @default(autoincrement())
  /// ID de la receta que se está surtiendo
  recetaId          Int
  /// ID del usuario de farmacia que entrega
  usuarioId         Int
  /// ID del establecimiento donde ocurre la entrega
  establecimientoId Int
  /// Fecha y hora de la entrega
  fecha             DateTime @default(now())

  /// Relación con la receta
  receta          Receta                @relation(fields: [recetaId], references: [id])
  /// Relación con el usuario farmacéutico
  usuario         Usuario               @relation(fields: [usuarioId], references: [id])
  /// Relación con el establecimiento
  establecimiento Establecimiento       @relation(fields: [establecimientoId], references: [id])
  /// Medicamentos específicos entregados en esta transacción
  detalles        DispensacionDetalle[]

  @@map("dispensaciones")
}

/// Detalle de las unidades entregadas por cada ítem de la receta
model DispensacionDetalle {
  /// Identificador único
  id              Int @id @default(autoincrement())
  /// ID de la transacción de dispensación
  dispensacionId  Int
  /// ID del renglón de la receta original
  detalleRecetaId Int
  /// ID del registro de inventario (lote) de donde salió el producto
  inventarioId    Int
  /// Cantidad física entregada al paciente
  cantidad        Int

  /// Relación con la cabecera de dispensación
  dispensacion  Dispensacion  @relation(fields: [dispensacionId], references: [id])
  /// Relación con el detalle de la receta
  detalleReceta DetalleReceta @relation(fields: [detalleRecetaId], references: [id])
  /// Relación con el lote de inventario
  inventario    Inventario    @relation(fields: [inventarioId], references: [id])

  @@map("dispensacion_detalles")
}

