/// Representa una sala o pabellÃ³n dentro de un servicio mÃ©dico
model Sala {
  /// Identificador Ãºnico
  id     Int     @id @default(autoincrement())
  /// Nombre descriptivo (ej: Sala de Hombres)
  nombre String  @db.VarChar(100)
  /// CÃ³digo interno de la sala
