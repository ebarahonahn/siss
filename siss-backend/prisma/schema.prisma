generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Representa los roles de usuario en el sistema para control de acceso basado en roles (RBAC)
model Rol {
  /// Identificador único autoincremental del rol
  id           Int                 @id @default(autoincrement())
  /// Nombre único del rol (ej: ADMIN, MEDICO, ENFERMERA)
  nombre       String              @unique @db.VarChar(50)
  /// Descripción detallada de las funciones del rol
  descripcion  String?             @db.VarChar(200)
  /// Objeto JSON que define los permisos específicos del rol por módulo
  permisos     Json
  asignaciones AsignacionUsuario[]
  usuarios     Usuario[]

  @@map("roles")
}

/// Representa a los usuarios del sistema (personal médico, administrativo y de enfermería)
model Usuario {
  /// Identificador único autoincremental del usuario
  id                           Int                          @id @default(autoincrement())
  /// Número de empleado institucional
  numeroEmpleado               String                       @unique @db.VarChar(20)
  /// Nombres del usuario
  nombres                      String                       @db.VarChar(100)
  /// Apellidos del usuario
  apellidos                    String                       @db.VarChar(100)
  /// Correo electrónico institucional (usado para login)
  correo                       String                       @unique @db.VarChar(150)
  /// Hash de la contraseña del usuario (Bcrypt)
  contrasenaHash               String                       @db.VarChar(255)
  /// Número de teléfono de contacto
  telefono                     String?                      @db.VarChar(20)
  /// ID de la especialidad primaria del usuario (si aplica)
  especialidadId               Int?
  /// Número de colegiación profesional (obligatorio para médicos)
  numeroColegiado              String?                      @db.VarChar(50)
  /// Indica si el usuario está activo en el sistema
  activo                       Boolean                      @default(true)
  /// Fecha y hora del último acceso exitoso
  ultimoAcceso                 DateTime?
  /// ID del rol principal asignado
  rolId                        Int?
  /// ID del establecimiento base donde labora
  establecimientoId            Int?
  /// Indica si el usuario debe cambiar su contraseña en el próximo inicio de sesión
  requiereCambioContrasena     Boolean                      @default(false)
  /// Coordenada geográfica de latitud
  latitud                      Decimal?                     @db.Decimal(10, 8)
  /// Coordenada geográfica de longitud
  longitud                     Decimal?                     @db.Decimal(11, 8)
  agendasBase                  AgendaBase[]                 @relation("AgendaMedico")
  asignaciones                 AsignacionUsuario[]
  auditLogs                    AuditLog[]
  embarazosCreados             Embarazo[]                   @relation("EmbarazoCreadoPor")
  embarazosActualizados        Embarazo[]                   @relation("EmbarazoActualizadoPor")
  embarazosEliminados          Embarazo[]                   @relation("EmbarazoEliminadoPor")
  controlesCreados             ControlPrenatal[]            @relation("ControlPrenatalCreadoPor")
  controlesActualizados        ControlPrenatal[]            @relation("ControlPrenatalActualizadoPor")
  antecedentesCreados          AntecedentesObstetricos[]    @relation("AntecedentesCreadoPor")
  antecedentesActualizados     AntecedentesObstetricos[]    @relation("AntecedentesActualizadoPor")
  citasCanceladas              Cita[]                       @relation("CitaCanceladaPor")
  citasCreadas                 Cita[]                       @relation("CitaCreadaPor")
  citasMedico                  Cita[]                       @relation("CitaMedico")
  controlSignosVitales         ControlSignosVitales[]
  dispensaciones               Dispensacion[]
  egresosFirmados              EgresoHospitalario[]         @relation("MedicoEgreso")
  especialidadesActualizadas   Especialidad[]               @relation("EspecialidadActualizadaPor")
  especialidadesCreadas        Especialidad[]               @relation("EspecialidadCreadaPor")
  establecimientosActualizados Establecimiento[]            @relation("EstablecimientoActualizadoPor")
  establecimientosCreados      Establecimiento[]            @relation("EstablecimientoCreadoPor")
  establecimientosEliminados   Establecimiento[]            @relation("EstablecimientoEliminadoPor")
  excepcionesAgenda            ExcepcionAgenda[]            @relation("ExcepcionMedico")
  historiasActualizadas        HistoriaClinica[]            @relation("HistoriaActualizadaPor")
  historiasEliminadas          HistoriaClinica[]            @relation("HistoriaEliminadaPor")
  historiales                  HistoriaClinica[]
  ingresosAutorizados          IngresoHospitalario[]        @relation("MedicoIngreso")
  inventariosActualizados      Inventario[]                 @relation("InventarioActualizadoPor")
  inventariosCreados           Inventario[]                 @relation("InventarioCreadoPor")
  inventariosEliminados        Inventario[]                 @relation("InventarioEliminadoPor")
  kardexMedicamentos           KardexMedicamento[]
  medicamentosActualizados     Medicamento[]                @relation("MedicamentoActualizadoPor")
  medicamentosCreados          Medicamento[]                @relation("MedicamentoCreadoPor")
  medicamentosEliminados       Medicamento[]                @relation("MedicamentoEliminadoPor")
  movimientosInventario        MovimientoInventario[]
  movimientosVacunas           MovimientoVacuna[]
  notasEvolucion               NotaEvolucion[]
  notificacionesCreadas        NotificacionEpidemiologica[] @relation("NotificacionCreadaPor")
  notificacionesGestionadas    NotificacionEpidemiologica[] @relation("GestionadoPor")
  pacientesEliminados          Paciente[]                   @relation("PacienteEliminadoPor")
  plantillasCreadas            PlantillaFormulario[]
  vacunasAplicadas             VacunacionRegistro[]
  sesiones                     Sesion[]
  solicitudesProcesadas        SolicitudUsuario[]           @relation("SolicitudesProcesadas")
  triajes                      Triaje[]                     @relation("TriajeEnfermera")
  especialidad                 Especialidad?                @relation(fields: [especialidadId], references: [id])
  establecimiento              Establecimiento?             @relation(fields: [establecimientoId], references: [id])
  rol                          Rol?                         @relation(fields: [rolId], references: [id])

  @@index([especialidadId], map: "usuarios_especialidadId_fkey")
  @@index([establecimientoId], map: "usuarios_establecimientoId_fkey")
  @@index([rolId], map: "usuarios_rolId_fkey")
  @@map("usuarios")
}

/// Representa las sesiones de autenticación activas mediante Refresh Tokens
model Sesion {
  /// Identificador único de la sesión
  id               Int      @id @default(autoincrement())
  /// ID del usuario dueño de la sesión
  usuarioId        Int
  /// Hash del Refresh Token almacenado para validación de seguridad
  refreshTokenHash String   @db.VarChar(255)
  /// Fecha de expiración del token
  expiresAt        DateTime
  /// Dirección IP desde la cual se inició la sesión
  ip               String?  @db.VarChar(45)
  /// User Agent del navegador/dispositivo que inició la sesión
  userAgent        String?  @db.VarChar(500)
  /// Fecha y hora de creación de la sesión
  creadaEn         DateTime @default(now())
  usuario          Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId], map: "sesiones_usuarioId_fkey")
  @@map("sesiones")
}

/// Representa una solicitud de creación de usuario desde la aplicación móvil
model SolicitudUsuario {
  /// Identificador único
  id             Int             @id @default(autoincrement())
  /// Documento Nacional de Identificación
  dni            String          @unique @db.VarChar(13)
  /// Nombres del solicitante
  nombres        String          @db.VarChar(100)
  /// Apellidos del solicitante
  apellidos      String          @db.VarChar(100)
  /// Correo electrónico para notificar resolución
  correo         String          @db.VarChar(150)
  /// Número de teléfono de contacto
  telefono       String?         @db.VarChar(20)
  /// Motivo o justificación de la solicitud
  justificacion  String?         @db.Text
  /// Estado de la solicitud (PENDIENTE, APROBADA, RECHAZADA)
  estado         EstadoSolicitud @default(PENDIENTE)
  /// Observaciones del administrador al procesar
  observaciones  String?         @db.VarChar(500)
  /// Fecha de envío de la solicitud
  creadaEn       DateTime        @default(now())
  /// Fecha de resolución
  procesadaEn    DateTime?
  /// ID del usuario que procesó la solicitud
  procesadaPorId Int?
  /// Coordenada geográfica de latitud del domicilio
  latitud        Decimal?        @db.Decimal(10, 8)
  /// Coordenada geográfica de longitud del domicilio
  longitud       Decimal?        @db.Decimal(11, 8)
  procesadaPor   Usuario?        @relation("SolicitudesProcesadas", fields: [procesadaPorId], references: [id])

  @@index([procesadaPorId], map: "solicitudes_usuario_procesadaPorId_fkey")
  @@map("solicitudes_usuario")
}

/// Representa los centros de salud, hospitales y clínicas de la red de servicios
model Establecimiento {
  /// Identificador único autoincremental
  id                Int                                 @id @default(autoincrement())
  /// Código institucional único (ej: HNT-001)
  codigo            String                              @unique @db.VarChar(20)
  /// Nombre completo del establecimiento
  nombre            String                              @db.VarChar(200)
  /// Nivel o tipo de establecimiento (Hospital, Centro de Salud, etc.)
  tipo              TipoEstablecimiento
  /// ID del departamento geográfico donde se ubica
  departamentoId    Int
  /// ID del municipio donde se ubica
  municipioId       Int
  /// Teléfono de contacto institucional
  telefono          String?                             @db.VarChar(20)
  /// Indica si el establecimiento está operativo
  activo            Boolean                             @default(true)
  /// Fecha de registro en el sistema
  creadoEn          DateTime                            @default(now())
  /// Fecha de última actualización de datos
  actualizadoEn     DateTime?                           @updatedAt
  /// Fecha de eliminación lógica (si aplica)
  eliminadoEn       DateTime?
  /// ID del usuario que registró el establecimiento
  creadoPorId       Int?
  /// ID del usuario que realizó la última actualización
  actualizadoPorId  Int?
  /// ID del usuario que realizó la eliminación lógica
  eliminadoPorId    Int?
  agendasBase       AgendaBase[]
  asignaciones      AsignacionUsuario[]
  citas             Cita[]
  dispensaciones    Dispensacion[]
  actualizadoPor    Usuario?                            @relation("EstablecimientoActualizadoPor", fields: [actualizadoPorId], references: [id])
  creadoPor         Usuario?                            @relation("EstablecimientoCreadoPor", fields: [creadoPorId], references: [id])
  departamento      Departamento                        @relation(fields: [departamentoId], references: [id])
  eliminadoPor      Usuario?                            @relation("EstablecimientoEliminadoPor", fields: [eliminadoPorId], references: [id])
  municipio         Municipio                           @relation(fields: [municipioId], references: [id], map: "establecimientos_municipio_fkey_unique")
  radiologia        EstudioRadiologicoEstablecimiento[]
  laboratorios      ExamenEstablecimiento[]
  excepcionesAgenda ExcepcionAgenda[]
  inventarios       Inventario[]
  lotesVacunas      LoteVacuna[]
  pacientes         Paciente[]
  recetas           Receta[]
  referidosDestino  Referido[]                          @relation("ReferidoDestino")
  referidosOrigen   Referido[]                          @relation("ReferidoOrigen")
  registrosVacunas  VacunacionRegistro[]
  servicios         Servicio[]
  solicitudesLab    SolicitudLaboratorio[]
  solicitudesRad    SolicitudRadiologia[]
  usuarios          Usuario[]

  @@index([actualizadoPorId], map: "establecimientos_actualizadoPorId_fkey")
  @@index([creadoPorId], map: "establecimientos_creadoPorId_fkey")
  @@index([departamentoId], map: "establecimientos_departamentoId_fkey")
  @@index([eliminadoPorId], map: "establecimientos_eliminadoPorId_fkey")
  @@index([municipioId], map: "establecimientos_municipio_fkey_unique")
  @@map("establecimientos")
}

/// Catálogo maestro de servicios o unidades funcionales (ej: Emergencias, Farmacia)
model CatServicio {
  /// Identificador único
  id          Int        @id @default(autoincrement())
  /// Nombre único del servicio
  nombre      String     @unique @db.VarChar(100)
  /// Descripción de las funciones del servicio
  descripcion String?    @db.VarChar(300)
  /// Indica si el servicio está activo para ser asignado
  activo      Boolean    @default(true)
  servicios   Servicio[]

  @@map("cat_servicios")
}

/// Registro de reportes analíticos disponibles en la plataforma
model ReporteDisponible {
  /// Identificador único
  id          Int     @id @default(autoincrement())
  /// Nombre legible del reporte
  nombre      String  @db.VarChar(100)
  /// Descripción de la utilidad y datos que contiene
  descripcion String? @db.VarChar(200)
  /// Categoría para agrupación en la UI (MEDICA, FARMACIA, etc.)
  categoria   String  @db.VarChar(50)
  /// Identificador interno para la lógica de generación
  slug        String  @unique @db.VarChar(50)
  /// Formato de salida (EXCEL, PDF)
  tipo        String  @db.VarChar(10)
  /// Permiso granular requerido para acceder a este reporte
  permiso     String  @db.VarChar(50)
  /// Nombre del icono decorativo en la UI
  icono       String? @db.VarChar(50)
  /// Indica si el reporte está disponible actualmente
  activo      Boolean @default(true)
  /// Orden de aparición en el listado
  orden       Int     @default(0)

  @@map("reportes_disponibles")
}

/// Representa la habilitación de un servicio del catálogo en un establecimiento específico
model Servicio {
  /// Identificador único
  id                Int                   @id @default(autoincrement())
  /// Indica si el servicio está operativo en este establecimiento
  activo            Boolean               @default(true)
  /// ID del establecimiento
  establecimientoId Int
  /// ID del servicio del catálogo
  catServicioId     Int
  asignaciones      AsignacionUsuario[]
  ingresos          IngresoHospitalario[]
  salas             Sala[]
  catServicio       CatServicio           @relation(fields: [catServicioId], references: [id])
  establecimiento   Establecimiento       @relation(fields: [establecimientoId], references: [id])

  @@index([catServicioId], map: "servicios_catServicioId_fkey")
  @@index([establecimientoId], map: "servicios_establecimientoId_fkey")
  @@map("servicios")
}

/// Catálogo maestro de tipos de habitaciones (ej: Privada, Bipersonal, Sala Común)
model CatTipoHabitacion {
  /// Identificador único
  id           Int          @id @default(autoincrement())
  /// Nombre del tipo de habitación
  nombre       String       @unique @db.VarChar(50)
  /// Descripción de las características
  descripcion  String?      @db.VarChar(200)
  habitaciones Habitacion[]

  @@map("cat_tipos_habitacion")
}

/// Catálogo maestro de tipos de camas (ej: Cama Eléctrica, Camilla, Cuna, Incubadora)
model CatTipoCama {
  /// Identificador único
  id          Int     @id @default(autoincrement())
  /// Nombre del tipo de cama
  nombre      String  @unique @db.VarChar(50)
  /// Descripción técnica
  descripcion String? @db.VarChar(200)
  camas       Cama[]

  @@map("cat_tipos_cama")
}

/// Representa una sala o pabellón dentro de un servicio médico
model Sala {
  /// Identificador único
  id           Int          @id @default(autoincrement())
  /// Nombre descriptivo (ej: Sala de Hombres)
  nombre       String       @db.VarChar(100)
  /// Código interno de la sala
  codigo       String?      @db.VarChar(20)
  /// Indica si la sala está activa
  activo       Boolean      @default(true)
  /// ID del servicio al que pertenece
  servicioId   Int
  habitaciones Habitacion[]
  servicio     Servicio     @relation(fields: [servicioId], references: [id])

  @@index([servicioId], map: "salas_servicioId_fkey")
  @@map("salas")
}

/// Representa una habitación o pieza física dentro de una sala
model Habitacion {
  /// Identificador único
  id               Int               @id @default(autoincrement())
  /// Número o nombre de la habitación (ej: 101, A-1)
  numero           String            @db.VarChar(20)
  /// Indica si la habitación está operativa
  activo           Boolean           @default(true)
  /// ID de la sala a la que pertenece
  salaId           Int
  /// ID del tipo de habitación
  tipoHabitacionId Int
  camas            Cama[]
  sala             Sala              @relation(fields: [salaId], references: [id])
  tipoHabitacion   CatTipoHabitacion @relation(fields: [tipoHabitacionId], references: [id])

  @@index([salaId], map: "habitaciones_salaId_fkey")
  @@index([tipoHabitacionId], map: "habitaciones_tipoHabitacionId_fkey")
  @@map("habitaciones")
}

/// Representa la unidad funcional final de hospitalización
model Cama {
  /// Identificador único
  id                 Int                      @id @default(autoincrement())
  /// Código único de identificación de la cama
  codigo             String                   @unique @db.VarChar(20)
  /// Estado actual de la cama
  estado             EstadoCama               @default(DISPONIBLE)
  /// Indica si la cama está activa físicamente
  activo             Boolean                  @default(true)
  /// ID de la habitación a la que pertenece
  habitacionId       Int
  /// ID del tipo de cama
  tipoCamaId         Int
  habitacion         Habitacion               @relation(fields: [habitacionId], references: [id])
  tipoCama           CatTipoCama              @relation(fields: [tipoCamaId], references: [id])
  ingresos           IngresoHospitalario[]
  movimientosDestino MovimientoHospitalario[] @relation("CamaDestino")
  movimientosOrigen  MovimientoHospitalario[] @relation("CamaOrigen")

  @@index([habitacionId], map: "camas_habitacionId_fkey")
  @@index([tipoCamaId], map: "camas_tipoCamaId_fkey")
  @@map("camas")
}

/// Permite la gestión de personal en múltiples establecimientos y servicios con roles diferenciados
model AsignacionUsuario {
  /// Identificador único
  id                Int             @id @default(autoincrement())
  /// ID del usuario asignado
  usuarioId         Int
  /// ID del establecimiento de la asignación
  establecimientoId Int
  /// ID del servicio (opcional) si la asignación es a una unidad funcional específica
  servicioId        Int?
  /// ID del rol (opcional) si el usuario tiene un rol distinto en este establecimiento
  rolId             Int?
  /// ID de la especialidad (opcional) si ejerce una especialidad distinta aquí
  especialidadId    Int?
  /// Indica si la asignación está vigente
  activo            Boolean         @default(true)
  /// Sobrescritura opcional de permisos específicos para esta asignación
  permisos          Json?
  /// Fecha de creación de la asignación
  creadoEn          DateTime        @default(now())
  /// Fecha de última modificación
  actualizadoEn     DateTime        @updatedAt
  especialidad      Especialidad?   @relation(fields: [especialidadId], references: [id])
  establecimiento   Establecimiento @relation(fields: [establecimientoId], references: [id])
  rol               Rol?            @relation(fields: [rolId], references: [id])
  servicio          Servicio?       @relation(fields: [servicioId], references: [id])
  usuario           Usuario         @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, establecimientoId, servicioId, especialidadId])
  @@index([especialidadId], map: "asignaciones_usuario_especialidadId_fkey")
  @@index([establecimientoId], map: "asignaciones_usuario_establecimientoId_fkey")
  @@index([rolId], map: "asignaciones_usuario_rolId_fkey")
  @@index([servicioId], map: "asignaciones_usuario_servicioId_fkey")
  @@map("asignaciones_usuario")
}

/// Catálogo de especialidades médicas (ej: Pediatría, Ginecología)
model Especialidad {
  /// Identificador único
  id               Int                   @id @default(autoincrement())
  /// Código abreviado de la especialidad (ej: PED, GIN)
  codigo           String                @unique @db.VarChar(20)
  /// Nombre completo de la especialidad
  nombre           String                @db.VarChar(100)
  /// Breve descripción del alcance de la especialidad
  descripcion      String?               @db.VarChar(300)
  /// Indica si la especialidad está activa para nuevas asignaciones
  activa           Boolean               @default(true)
  /// Fecha de registro
  creadoEn         DateTime              @default(now())
  /// Fecha de última actualización
  actualizadoEn    DateTime?             @updatedAt
  /// ID del usuario que registró la especialidad
  creadoPorId      Int?
  /// ID del usuario que realizó la última actualización
  actualizadoPorId Int?
  asignaciones     AsignacionUsuario[]
  citas            Cita[]
  actualizadoPor   Usuario?              @relation("EspecialidadActualizadaPor", fields: [actualizadoPorId], references: [id])
  creadoPor        Usuario?              @relation("EspecialidadCreadaPor", fields: [creadoPorId], references: [id])
  plantillas       PlantillaFormulario[]
  usuarios         Usuario[]

  @@index([actualizadoPorId], map: "especialidades_actualizadoPorId_fkey")
  @@index([creadoPorId], map: "especialidades_creadoPorId_fkey")
  @@map("especialidades")
}

/// Registro central de datos personales y demográficos de los pacientes
model Paciente {
  /// Identificador único autoincremental
  id                            Int                          @id @default(autoincrement())
  /// Número de expediente único generado por el sistema
  numeroExpediente              String                       @unique @db.VarChar(20)
  /// Documento Nacional de Identificación (Honduras)
  dni                           String                       @unique @db.VarChar(13)
  /// Nombres del paciente
  nombres                       String                       @db.VarChar(100)
  /// Apellidos del paciente
  apellidos                     String                       @db.VarChar(100)
  /// Fecha de nacimiento
  fechaNacimiento               DateTime                     @db.Date
  /// ID del catálogo de sexos
  sexoId                        Int
  /// ID del catálogo de tipos de sangre
  tipoSangreId                  Int?
  /// Teléfono de contacto
  telefono                      String?                      @db.VarChar(20)
  /// Teléfono de contacto para emergencias
  telefonoEmergencia            String?                      @db.VarChar(20)
  /// Correo electrónico (opcional)
  correo                        String?                      @db.VarChar(150)
  /// Dirección de domicilio detallada
  direccion                     String?                      @db.VarChar(300)
  /// ID del departamento de domicilio
  departamentoId                Int
  /// ID del municipio de domicilio
  municipioId                   Int
  /// Nombre de la comunidad, barrio o colonia
  comunidad                     String?                      @db.VarChar(100)
  /// ID del catálogo de escolaridad
  escolaridadId                 Int?
  /// ID del catálogo de ocupaciones
  ocupacionId                   Int?
  /// ID del catálogo de estado civil
  estadoCivilId                 Int?
  /// Indica si el paciente está activo para atención
  activo                        Boolean                      @default(true)
  /// Fecha de registro inicial en el sistema
  fechaRegistro                 DateTime                     @default(now())
  /// Fecha de última actualización de datos demográficos
  actualizadoEn                 DateTime?                    @updatedAt
  /// Fecha de eliminación lógica
  eliminadoEn                   DateTime?
  /// ID del establecimiento donde se registró el paciente
  establecimientoId             Int
  /// ID del usuario que registró al paciente
  creadoPorId                   Int
  /// ID del usuario que realizó la última actualización
  actualizadoPorId              Int?
  /// ID del usuario que realizó la eliminación lógica
  eliminadoPorId                Int?
  /// Coordenada geográfica de latitud del domicilio
  latitud                       Decimal?                     @db.Decimal(10, 8)
  /// Coordenada geográfica de longitud del domicilio
  longitud                      Decimal?                     @db.Decimal(11, 8)
  alergias                      Alergia[]
  citas                         Cita[]
  embarazos                     Embarazo[]
  historialClinico              HistoriaClinica[]
  ingresos                      IngresoHospitalario[]
  notificacionesEpidemiologicas NotificacionEpidemiologica[]
  medicamentosActivos           PacienteMedicamento[]
  departamento                  Departamento                 @relation(fields: [departamentoId], references: [id])
  eliminadoPor                  Usuario?                     @relation("PacienteEliminadoPor", fields: [eliminadoPorId], references: [id])
  escolaridad                   Escolaridad?                 @relation(fields: [escolaridadId], references: [id])
  establecimiento               Establecimiento              @relation(fields: [establecimientoId], references: [id])
  estadoCivil                   EstadoCivil?                 @relation(fields: [estadoCivilId], references: [id])
  municipio                     Municipio                    @relation(fields: [municipioId], references: [id])
  ocupacion                     Ocupacion?                   @relation(fields: [ocupacionId], references: [id])
  sexo                          Sexo                         @relation(fields: [sexoId], references: [id])
  tipoSangre                    TipoSangre?                  @relation(fields: [tipoSangreId], references: [id])
  usuario                       PacienteUsuario?
  recetas                       Receta[]
  vacunas                       VacunacionRegistro[]
  solicitudesLab                SolicitudLaboratorio[]
  solicitudesRad                SolicitudRadiologia[]
  triajes                       Triaje[]

  @@index([departamentoId], map: "pacientes_departamentoId_fkey")
  @@index([eliminadoPorId], map: "pacientes_eliminadoPorId_fkey")
  @@index([escolaridadId], map: "pacientes_escolaridadId_fkey")
  @@index([establecimientoId], map: "pacientes_establecimientoId_fkey")
  @@index([estadoCivilId], map: "pacientes_estadoCivilId_fkey")
  @@index([municipioId], map: "pacientes_municipioId_fkey")
  @@index([ocupacionId], map: "pacientes_ocupacionId_fkey")
  @@index([sexoId], map: "pacientes_sexoId_fkey")
  @@index([tipoSangreId], map: "pacientes_tipoSangreId_fkey")
  @@map("pacientes")
}

/// Catálogo de sexos para registro demográfico
model Sexo {
  /// Identificador único
  id        Int        @id @default(autoincrement())
  /// Nombre del sexo (Masculino, Femenino)
  nombre    String     @unique @db.VarChar(20)
  pacientes Paciente[]

  @@map("cat_sexos")
}

/// Catálogo de tipos de sangre y factor RH
model TipoSangre {
  /// Identificador único
  id        Int        @id @default(autoincrement())
  /// Nombre del tipo de sangre (ej: O+, A-)
  nombre    String     @unique @db.VarChar(20)
  pacientes Paciente[]

  @@map("cat_tipos_sangre")
}

/// Catálogo de niveles de escolaridad alcanzados
model Escolaridad {
  /// Identificador único
  id        Int        @id @default(autoincrement())
  /// Nombre del nivel (ej: Primaria, Universitaria)
  nombre    String     @unique @db.VarChar(50)
  pacientes Paciente[]

  @@map("cat_escolaridades")
}

/// Catálogo de estados civiles
model EstadoCivil {
  /// Identificador único
  id        Int        @id @default(autoincrement())
  /// Nombre del estado (ej: Soltero, Casado)
  nombre    String     @unique @db.VarChar(30)
  pacientes Paciente[]

  @@map("cat_estados_civiles")
}

/// Catálogo de ocupaciones o profesiones
model Ocupacion {
  /// Identificador único
  id        Int        @id @default(autoincrement())
  /// Nombre de la ocupación
  nombre    String     @unique @db.VarChar(100)
  pacientes Paciente[]

  @@map("cat_ocupaciones")
}

/// Registro de alergias conocidas de un paciente
model Alergia {
  /// Identificador único
  id          Int         @id @default(autoincrement())
  /// ID del paciente afectado
  pacienteId  Int
  /// Categoría de la alergia (Medicamento, Alimento, etc.)
  tipo        TipoAlergia
  /// Descripción de la sustancia y reacción
  descripcion String      @db.VarChar(300)
  /// Grado de peligrosidad de la alergia
  severidad   Severidad
  paciente    Paciente    @relation(fields: [pacienteId], references: [id])

  @@index([pacienteId], map: "alergias_pacienteId_fkey")
  @@map("alergias")
}

/// Gestión de citas médicas y programación de consultas
model Cita {
  /// Identificador único
  id                Int              @id @default(autoincrement())
  /// ID del paciente que solicita la cita
  pacienteId        Int
  /// ID del médico asignado (opcional si es urgencia)
  medicoId          Int
  /// ID del establecimiento donde se realizará la cita
  establecimientoId Int
  /// Fecha y hora programada para la atención
  fechaHora         DateTime
  /// Tiempo estimado de duración del encuentro médico
  duracionMinutos   Int              @default(20)
  /// Tipo de atención solicitada
  tipo              TipoCita
  /// Estado actual de la cita (Programada, Atendida, etc.)
  estado            EstadoCita       @default(PROGRAMADA)
  /// Motivo breve de la consulta
  motivo            String?          @db.VarChar(500)
  /// Observaciones adicionales
  notas             String?          @db.Text
  /// Fecha de registro de la cita
  creadaEn          DateTime         @default(now())
  /// ID del usuario (recepcionista) que registró la cita
  creadoPorId       Int?
  /// ID del usuario que canceló la cita (si aplica)
  canceladoPorId    Int?
  /// ID de la especialidad bajo la cual se atiende la cita
  especialidadId    Int?
  canceladoPor      Usuario?         @relation("CitaCanceladaPor", fields: [canceladoPorId], references: [id])
  creadoPor         Usuario?         @relation("CitaCreadaPor", fields: [creadoPorId], references: [id])
  especialidad      Especialidad?    @relation(fields: [especialidadId], references: [id])
  establecimiento   Establecimiento  @relation(fields: [establecimientoId], references: [id])
  medico            Usuario          @relation("CitaMedico", fields: [medicoId], references: [id])
  paciente          Paciente         @relation(fields: [pacienteId], references: [id])
  historia          HistoriaClinica?
  historiaOrigen    HistoriaClinica? @relation("ProximaCita")
  triaje            Triaje?

  @@index([canceladoPorId], map: "citas_canceladoPorId_fkey")
  @@index([creadoPorId], map: "citas_creadoPorId_fkey")
  @@index([especialidadId], map: "citas_especialidadId_fkey")
  @@index([establecimientoId], map: "citas_establecimientoId_fkey")
  @@index([medicoId], map: "citas_medicoId_fkey")
  @@index([pacienteId], map: "citas_pacienteId_fkey")
  @@map("citas")
}

/// Representa el encuentro clínico (consulta) y el registro médico del paciente
model HistoriaClinica {
  /// Identificador único
  id                         Int                         @id @default(autoincrement())
  /// ID del paciente atendido
  pacienteId                 Int
  /// ID del médico tratante
  medicoId                   Int
  /// ID de la cita asociada
  citaId                     Int?                        @unique
  /// ID de la plantilla de formulario utilizada
  plantillaId                Int?
  /// Fecha y hora de la atención
  fecha                      DateTime                    @default(now())
  /// [S]ubjetivo: Motivo de consulta, síntomas y anamnesis
  subjetivo                  String                      @db.Text
  /// [O]bjetivo: Hallazgos del examen físico
  objetivo                   String                      @db.Text
  /// [A]nálisis: Razonamiento médico y diagnósticos presuntivos
  analisis                   String                      @db.Text
  /// [P]lan: Tratamiento, medicamentos, exámenes y recomendaciones
  plan                       String                      @db.Text
  /// Tensión arterial sistólica (mmHg)
  presionSistolica           Int?
  /// Tensión arterial diastólica (mmHg)
  presionDiastolica          Int?
  /// Latidos por minuto
  frecuenciaCardiaca         Int?
  /// Temperatura corporal (Â°C)
  temperatura                Decimal?                    @db.Decimal(4, 1)
  /// Peso del paciente (kg)
  peso                       Decimal?                    @db.Decimal(5, 2)
  /// Estatura del paciente (cm)
  talla                      Decimal?                    @db.Decimal(4, 1)
  /// Porcentaje de saturación de oxígeno
  saturacionO2               Int?
  /// Número de semana epidemiológica (1-52)
  semanaEpidemiologica       Int?
  /// Fecha de la última modificación
  actualizadoEn              DateTime?
  /// Fecha de eliminación lógica
  eliminadoEn                DateTime?
  /// ID del usuario que actualizó el registro
  actualizadoPorId           Int?
  /// ID del usuario que eliminó el registro
  eliminadoPorId             Int?
  /// ID de la próxima cita programada
  proximaCitaId              Int?                        @unique
  diagnosticos               Diagnostico[]
  controlPrenatal            ControlPrenatal?
  actualizadoPor             Usuario?                    @relation("HistoriaActualizadaPor", fields: [actualizadoPorId], references: [id])
  cita                       Cita?                       @relation(fields: [citaId], references: [id])
  eliminadoPor               Usuario?                    @relation("HistoriaEliminadaPor", fields: [eliminadoPorId], references: [id])
  medico                     Usuario                     @relation(fields: [medicoId], references: [id])
  paciente                   Paciente                    @relation(fields: [pacienteId], references: [id])
  plantilla                  PlantillaFormulario?        @relation(fields: [plantillaId], references: [id])
  proximaCita                Cita?                       @relation("ProximaCita", fields: [proximaCitaId], references: [id])
  incapacidades              Incapacidad[]
  notificacionEpidemiologica NotificacionEpidemiologica?
  recetas                    Receta[]
  referidos                  Referido[]
  respuestaFormulario        RespuestaFormulario?
  resultadosLab              ResultadoLaboratorio[]
  solicitudesLab             SolicitudLaboratorio[]
  solicitudesRad             SolicitudRadiologia[]

  @@index([actualizadoPorId], map: "historia_clinica_actualizadoPorId_fkey")
  @@index([eliminadoPorId], map: "historia_clinica_eliminadoPorId_fkey")
  @@index([medicoId], map: "historia_clinica_medicoId_fkey")
  @@index([pacienteId], map: "historia_clinica_pacienteId_fkey")
  @@index([plantillaId], map: "historia_clinica_plantillaId_fkey")
  @@map("historia_clinica")
}

/// Diagnósticos asociados a una atención médica (basados en CIE-10)
model Diagnostico {
  /// Identificador único
  id          Int             @id @default(autoincrement())
  /// ID de la historia clínica asociada
  historiaId  Int
  /// Código alfanumérico CIE-10
  codigoCIE10 String          @db.VarChar(10)
  /// Descripción del diagnóstico según catálogo
  descripcion String          @db.VarChar(500)
  /// Importancia del diagnóstico (Principal, Secundario)
  tipo        TipoDiagnostico
  historia    HistoriaClinica @relation(fields: [historiaId], references: [id])

  @@index([historiaId], map: "diagnosticos_historiaId_fkey")
  @@map("diagnosticos")
}

/// Registro de incapacidades médicas otorgadas al paciente
model Incapacidad {
  /// Identificador único
  id          Int             @id @default(autoincrement())
  /// ID de la historia clínica asociada
  historiaId  Int
  /// Fecha de inicio del reposo
  fechaInicio DateTime        @db.Date
  /// Fecha de finalización del reposo
  fechaFin    DateTime        @db.Date
  /// Total de días de incapacidad
  dias        Int
  /// Ãmbito de la incapacidad (Laboral, Escolar)
  tipo        TipoIncapacidad @default(LABORAL)
  /// Descripción de la justificación médica
  motivo      String          @db.VarChar(500)
  historia    HistoriaClinica @relation(fields: [historiaId], references: [id])

  @@index([historiaId], map: "incapacidades_historiaId_fkey")
  @@map("incapacidades")
}

/// Catálogo maestro de medicamentos y productos farmacéuticos
model Medicamento {
  /// Identificador único
  id                    Int                   @id @default(autoincrement())
  /// Código de barras o SKU del medicamento
  codigo                String                @unique @db.VarChar(30)
  /// Denominación Común Internacional (DCI)
  nombreGenerico        String                @db.VarChar(200)
  /// Nombre bajo el cual se comercializa (opcional)
  nombreComercial       String?               @db.VarChar(200)
  /// Forma farmacéutica (ej: Tabletas, Jarabe)
  presentacion          String                @db.VarChar(100)
  /// Cantidad de principio activo (ej: 500mg)
  concentracion         String                @db.VarChar(50)
  /// Método de ingreso al organismo
  via                   ViaAdministracion
  /// Clasificación terapéutica (ej: Antibióticos)
  grupoTerapeutico      String                @db.VarChar(100)
  /// Indica si requiere autorización médica para dispensar
  requiereReceta        Boolean               @default(true)
  /// Indica si el medicamento es psicotrópico o estupefaciente
  esControlado          Boolean               @default(false)
  /// Indica si el medicamento está disponible en el catálogo
  activo                Boolean               @default(true)
  /// Fecha de registro inicial
  creadoEn              DateTime              @default(now())
  /// Fecha de última actualización de ficha técnica
  actualizadoEn         DateTime?             @updatedAt
  /// Fecha de eliminación lógica
  eliminadoEn           DateTime?
  /// ID del usuario que registró el medicamento
  creadoPorId           Int?
  /// ID del usuario que realizó la última actualización
  actualizadoPorId      Int?
  /// ID del usuario que realizó la eliminación lógica
  eliminadoPorId        Int?
  detallesReceta        DetalleReceta[]
  inventario            Inventario[]
  kardexMedicamentos    KardexMedicamento[]
  actualizadoPor        Usuario?              @relation("MedicamentoActualizadoPor", fields: [actualizadoPorId], references: [id])
  creadoPor             Usuario?              @relation("MedicamentoCreadoPor", fields: [creadoPorId], references: [id])
  eliminadoPor          Usuario?              @relation("MedicamentoEliminadoPor", fields: [eliminadoPorId], references: [id])
  pacientesMedicamentos PacienteMedicamento[]

  @@index([actualizadoPorId], map: "medicamentos_actualizadoPorId_fkey")
  @@index([creadoPorId], map: "medicamentos_creadoPorId_fkey")
  @@index([eliminadoPorId], map: "medicamentos_eliminadoPorId_fkey")
  @@map("medicamentos")
}

/// Control de existencias físicas de medicamentos por establecimiento y lote
model Inventario {
  /// Identificador único
  id                Int                    @id @default(autoincrement())
  /// ID del medicamento asociado
  medicamentoId     Int
  /// ID del establecimiento que posee el stock
  establecimientoId Int
  /// Cantidad disponible actualmente para dispensar
  cantidadActual    Int                    @default(0)
  /// Nivel mínimo antes de generar alertas de reabastecimiento
  cantidadMinima    Int                    @default(10)
  /// Código del lote de fabricación para trazabilidad
  lote              String?                @db.VarChar(50)
  /// Fecha de expiración del lote
  fechaVencimiento  DateTime?              @db.Date
  /// Ubicación física dentro de la bodega/farmacia
  ubicacion         String?                @db.VarChar(100)
  /// Indica si este stock está disponible para uso
  activo            Boolean                @default(true)
  /// Fecha de registro del ingreso inicial
  creadoEn          DateTime               @default(now())
  /// Fecha de último movimiento o ajuste
  actualizadoEn     DateTime?              @updatedAt
  /// Fecha de eliminación (si aplica)
  eliminadoEn       DateTime?
  /// ID del usuario que registró el ingreso
  creadoPorId       Int?
  /// ID del usuario que realizó la última modificación
  actualizadoPorId  Int?
  /// ID del usuario que eliminó el registro
  eliminadoPorId    Int?
  dispensaciones    DispensacionDetalle[]
  actualizadoPor    Usuario?               @relation("InventarioActualizadoPor", fields: [actualizadoPorId], references: [id])
  creadoPor         Usuario?               @relation("InventarioCreadoPor", fields: [creadoPorId], references: [id])
  eliminadoPor      Usuario?               @relation("InventarioEliminadoPor", fields: [eliminadoPorId], references: [id])
  establecimiento   Establecimiento        @relation(fields: [establecimientoId], references: [id])
  medicamento       Medicamento            @relation(fields: [medicamentoId], references: [id])
  movimientos       MovimientoInventario[]

  @@unique([medicamentoId, establecimientoId, lote])
  @@index([actualizadoPorId], map: "inventario_actualizadoPorId_fkey")
  @@index([creadoPorId], map: "inventario_creadoPorId_fkey")
  @@index([eliminadoPorId], map: "inventario_eliminadoPorId_fkey")
  @@index([establecimientoId], map: "inventario_establecimientoId_fkey")
  @@map("inventario")
}

/// Registro histórico de transacciones que afectan el stock de medicamentos
model MovimientoInventario {
  /// Identificador único
  id           Int            @id @default(autoincrement())
  /// ID del registro de inventario afectado
  inventarioId Int
  /// Tipo de transacción (Entrada, Salida, etc.)
  tipo         TipoMovimiento
  /// Cantidad de unidades involucradas en el movimiento
  cantidad     Int
  /// Explicación del porqué del movimiento
  motivo       String?        @db.VarChar(200)
  /// ID del usuario que realizó la transacción
  usuarioId    Int
  /// Fecha y hora del registro
  fecha        DateTime       @default(now())
  inventario   Inventario     @relation(fields: [inventarioId], references: [id])
  usuario      Usuario        @relation(fields: [usuarioId], references: [id])

  @@index([inventarioId], map: "movimientos_inventario_inventarioId_fkey")
  @@index([usuarioId], map: "movimientos_inventario_usuarioId_fkey")
  @@map("movimientos_inventario")
}

/// Documento de prescripción médica para un paciente
model Receta {
  /// Identificador único
  id                Int             @id @default(autoincrement())
  /// ID de la historia clínica donde se originó la receta
  historiaId        Int
  /// ID del paciente beneficiario
  pacienteId        Int
  /// ID del establecimiento donde se emitió
  establecimientoId Int
  /// Estado actual del flujo de dispensación
  estado            EstadoReceta    @default(PENDIENTE)
  /// Fecha de emisión
  creadaEn          DateTime        @default(now())
  /// Fecha en la que se completó la entrega total
  dispensadaEn      DateTime?
  detalles          DetalleReceta[]
  dispensaciones    Dispensacion[]
  establecimiento   Establecimiento @relation(fields: [establecimientoId], references: [id])
  historia          HistoriaClinica @relation(fields: [historiaId], references: [id])
  paciente          Paciente        @relation(fields: [pacienteId], references: [id])

  @@index([establecimientoId], map: "recetas_establecimientoId_fkey")
  @@index([historiaId], map: "recetas_historiaId_fkey")
  @@index([pacienteId], map: "recetas_pacienteId_fkey")
  @@map("recetas")
}

/// Especificación de un medicamento individual dentro de una receta
model DetalleReceta {
  /// Identificador único
  id                 Int                   @id @default(autoincrement())
  /// ID de la receta a la que pertenece
  recetaId           Int
  /// ID del medicamento prescrito
  medicamentoId      Int
  /// Cantidad y unidad por toma (ej: 1 tableta)
  dosis              String                @db.VarChar(100)
  /// Intervalo de tiempo (ej: Cada 8 horas)
  frecuencia         String                @db.VarChar(100)
  /// Tiempo total de tratamiento (ej: 7 días)
  duracion           String                @db.VarChar(100)
  /// Cantidad total de unidades a dispensar
  cantidad           Int
  /// Acumulado de unidades ya entregadas
  cantidadEntregada  Int                   @default(0)
  /// Fecha del último despacho parcial
  ultimaDispensacion DateTime?
  /// Consejos adicionales para el paciente
  indicaciones       String?               @db.VarChar(500)
  medicamento        Medicamento           @relation(fields: [medicamentoId], references: [id])
  receta             Receta                @relation(fields: [recetaId], references: [id])
  dispensaciones     DispensacionDetalle[]

  @@index([medicamentoId], map: "detalles_receta_medicamentoId_fkey")
  @@index([recetaId], map: "detalles_receta_recetaId_fkey")
  @@map("detalles_receta")
}

/// Historial de medicación activa (tratamientos crónicos) de un paciente
model PacienteMedicamento {
  /// Identificador único
  id            Int         @id @default(autoincrement())
  /// ID del paciente
  pacienteId    Int
  /// ID del medicamento
  medicamentoId Int
  /// Dosis del tratamiento
  dosis         String      @db.VarChar(100)
  /// Frecuencia de administración
  frecuencia    String      @db.VarChar(100)
  /// Fecha de inicio del tratamiento
  inicio        DateTime    @db.Date
  /// Fecha estimada de finalización (null si es permanente)
  fin           DateTime?   @db.Date
  medicamento   Medicamento @relation(fields: [medicamentoId], references: [id])
  paciente      Paciente    @relation(fields: [pacienteId], references: [id])

  @@index([medicamentoId], map: "paciente_medicamentos_medicamentoId_fkey")
  @@index([pacienteId], map: "paciente_medicamentos_pacienteId_fkey")
  @@map("paciente_medicamentos")
}

/// Catálogo maestro de exámenes de laboratorio clínico disponibles
model CatExamenLaboratorio {
  /// Identificador único
  id                Int                           @id @default(autoincrement())
  /// Código interno único del examen
  codigo            String                        @unique @db.VarChar(20)
  /// Nombre descriptivo del examen
  nombre            String                        @db.VarChar(150)
  /// Ãrea del laboratorio (ej: Hematología, Química)
  categoria         String                        @db.VarChar(100)
  /// Requisitos para el paciente (ej: Ayuno 8h)
  indicaciones      String?                       @db.Text
  /// Indica si el examen está disponible en el catálogo general
  activo            Boolean                       @default(true)
  detallesSolicitud DetalleSolicitudLaboratorio[]
  establecimientos  ExamenEstablecimiento[]

  @@map("cat_examenes_laboratorio")
}

/// Tabla asociativa de exámenes habilitados por cada establecimiento
model ExamenEstablecimiento {
  /// ID del establecimiento
  establecimientoId Int
  /// ID del examen del catálogo
  examenId          Int
  establecimiento   Establecimiento      @relation(fields: [establecimientoId], references: [id])
  examen            CatExamenLaboratorio @relation(fields: [examenId], references: [id])

  @@id([establecimientoId, examenId])
  @@index([examenId], map: "examen_establecimientos_examenId_fkey")
  @@map("examen_establecimientos")
}

/// Orden de laboratorio clínico emitida durante una consulta
model SolicitudLaboratorio {
  /// Identificador único
  id                Int                           @id @default(autoincrement())
  /// ID de la historia clínica origen
  historiaId        Int
  /// ID del paciente
  pacienteId        Int
  /// ID del establecimiento donde se procesará
  establecimientoId Int
  /// Estado actual del flujo de laboratorio
  estado            EstadoLab                     @default(SOLICITADO)
  /// Prioridad de procesamiento
  urgente           Boolean                       @default(false)
  /// Notas médicas adicionales para el laboratorista
  observaciones     String?                       @db.Text
  /// Fecha de emisión de la orden
  creadaEn          DateTime                      @default(now())
  detalles          DetalleSolicitudLaboratorio[]
  resultados        ResultadoLaboratorio[]
  establecimiento   Establecimiento               @relation(fields: [establecimientoId], references: [id])
  historia          HistoriaClinica               @relation(fields: [historiaId], references: [id])
  paciente          Paciente                      @relation(fields: [pacienteId], references: [id])

  @@index([establecimientoId], map: "solicitudes_laboratorio_establecimientoId_fkey")
  @@index([historiaId], map: "solicitudes_laboratorio_historiaId_fkey")
  @@index([pacienteId], map: "solicitudes_laboratorio_pacienteId_fkey")
  @@map("solicitudes_laboratorio")
}

/// Detalle de cada examen incluido en una orden de laboratorio
model DetalleSolicitudLaboratorio {
  /// Identificador único
  id            Int                  @id @default(autoincrement())
  /// ID de la solicitud cabecera
  solicitudId   Int
  /// ID del examen específico
  examenId      Int
  /// Observaciones específicas para este examen
  observaciones String?              @db.VarChar(200)
  examen        CatExamenLaboratorio @relation(fields: [examenId], references: [id])
  solicitud     SolicitudLaboratorio @relation(fields: [solicitudId], references: [id])

  @@index([examenId], map: "detalles_solicitud_laboratorio_examenId_fkey")
  @@index([solicitudId], map: "detalles_solicitud_laboratorio_solicitudId_fkey")
  @@map("detalles_solicitud_laboratorio")
}

/// Registro de resultados numéricos o cualitativos de exámenes de laboratorio
model ResultadoLaboratorio {
  /// Identificador único
  id              Int                  @id @default(autoincrement())
  /// ID de la solicitud a la que pertenece el resultado
  solicitudId     Int
  /// ID opcional de la historia clínica para vinculación directa
  historiaId      Int?
  /// Nombre del parámetro o prueba analizada
  prueba          String               @db.VarChar(200)
  /// Resultado obtenido
  valor           String               @db.VarChar(200)
  /// Unidad de medida (ej: mg/dL, %)
  unidad          String?              @db.VarChar(50)
  /// Rango esperado para un paciente sano
  valorReferencia String?              @db.VarChar(100)
  /// Indica si el valor está fuera de los rangos normales
  anormal         Boolean              @default(false)
  /// Interpretación del microbiólogo o analista
  observaciones   String?              @db.Text
  /// Fecha y hora de validación del resultado
  fecha           DateTime             @default(now())
  historia        HistoriaClinica?     @relation(fields: [historiaId], references: [id])
  solicitud       SolicitudLaboratorio @relation(fields: [solicitudId], references: [id])

  @@index([historiaId], map: "resultados_laboratorio_historiaId_fkey")
  @@index([solicitudId], map: "resultados_laboratorio_solicitudId_fkey")
  @@map("resultados_laboratorio")
}

/// Catálogo maestro de estudios radiológicos e imagenología
model CatExamenRadiologico {
  /// Identificador único
  id                Int                                 @id @default(autoincrement())
  /// Código interno único (ej: RX-01, TAC-05)
  codigo            String                              @unique @db.VarChar(20)
  /// Nombre del estudio (ej: Rayos X de Tórax)
  nombre            String                              @db.VarChar(150)
  /// Modalidad de imagen (RX, ECO, TAC, RM, etc.)
  categoria         String                              @db.VarChar(100)
  /// Requisitos técnicos o del paciente
  indicaciones      String?                             @db.Text
  /// Indica si el estudio está disponible en el catálogo
  activo            Boolean                             @default(true)
  detallesSolicitud DetalleSolicitudRadiologia[]
  establecimientos  EstudioRadiologicoEstablecimiento[]

  @@map("cat_examenes_radiologia")
}

/// Tabla asociativa de estudios de imagen habilitados por establecimiento
model EstudioRadiologicoEstablecimiento {
  /// ID del establecimiento
  establecimientoId Int
  /// ID del estudio del catálogo
  estudioId         Int
  establecimiento   Establecimiento      @relation(fields: [establecimientoId], references: [id])
  estudio           CatExamenRadiologico @relation(fields: [estudioId], references: [id])

  @@id([establecimientoId, estudioId])
  @@index([estudioId], map: "estudio_radiologia_establecimientos_estudioId_fkey")
  @@map("estudio_radiologia_establecimientos")
}

/// Orden de estudios de imagenología emitida por un médico
model SolicitudRadiologia {
  /// Identificador único
  id                Int                          @id @default(autoincrement())
  /// ID de la historia clínica origen
  historiaId        Int
  /// ID del paciente
  pacienteId        Int
  /// ID del establecimiento de destino
  establecimientoId Int
  /// Estado del flujo (Solicitado, Completado)
  estado            EstadoLab                    @default(SOLICITADO)
  /// Prioridad de atención
  urgente           Boolean                      @default(false)
  /// Justificación clínica del estudio
  observaciones     String?                      @db.Text
  /// Fecha de emisión de la orden
  creadaEn          DateTime                     @default(now())
  detalles          DetalleSolicitudRadiologia[]
  resultados        ResultadoRadiologia[]
  establecimiento   Establecimiento              @relation(fields: [establecimientoId], references: [id])
  historia          HistoriaClinica              @relation(fields: [historiaId], references: [id])
  paciente          Paciente                     @relation(fields: [pacienteId], references: [id])

  @@index([establecimientoId], map: "solicitudes_radiologia_establecimientoId_fkey")
  @@index([historiaId], map: "solicitudes_radiologia_historiaId_fkey")
  @@index([pacienteId], map: "solicitudes_radiologia_pacienteId_fkey")
  @@map("solicitudes_radiologia")
}

/// Detalle de cada estudio individual en una orden de radiología
model DetalleSolicitudRadiologia {
  /// Identificador único
  id            Int                  @id @default(autoincrement())
  /// ID de la solicitud cabecera
  solicitudId   Int
  /// ID del estudio específico
  estudioId     Int
  /// Observaciones o sospechas diagnósticas para el radiólogo
  observaciones String?              @db.VarChar(200)
  estudio       CatExamenRadiologico @relation(fields: [estudioId], references: [id])
  solicitud     SolicitudRadiologia  @relation(fields: [solicitudId], references: [id])

  @@index([estudioId], map: "detalles_solicitud_radiologia_estudioId_fkey")
  @@index([solicitudId], map: "detalles_solicitud_radiologia_solicitudId_fkey")
  @@map("detalles_solicitud_radiologia")
}

/// Registro de la interpretación médica de un estudio de imagen
model ResultadoRadiologia {
  /// Identificador único
  id          Int                 @id @default(autoincrement())
  /// ID de la solicitud a la que pertenece el informe
  solicitudId Int
  /// Descripción detallada de lo observado en la imagen
  hallazgos   String?             @db.Text
  /// Diagnóstico radiológico final
  conclusion  String?             @db.Text
  /// Enlace al visor PACS o almacenamiento de la imagen digital
  imageUrl    String?             @db.VarChar(500)
  /// Fecha y hora del informe
  fecha       DateTime            @default(now())
  solicitud   SolicitudRadiologia @relation(fields: [solicitudId], references: [id])

  @@index([solicitudId], map: "resultados_radiologia_solicitudId_fkey")
  @@map("resultados_radiologia")
}

/// Gestión de referencias de pacientes entre establecimientos de la red
model Referido {
  /// Identificador único
  id                       Int             @id @default(autoincrement())
  /// ID de la historia clínica donde se origina el referido
  historiaId               Int
  /// Establecimiento que envía al paciente
  establecimientoOrigenId  Int
  /// Establecimiento que recibirá al paciente
  establecimientoDestinoId Int
  /// Especialidad a la que se remite
  especialidadDestino      String          @db.VarChar(100)
  /// Justificación clínica del traslado
  motivo                   String          @db.Text
  /// Prioridad de la referencia
  urgente                  Boolean         @default(false)
  /// Estado del trámite administrativo
  estado                   EstadoReferido  @default(EMITIDO)
  /// Fecha de emisión
  creadoEn                 DateTime        @default(now())
  destino                  Establecimiento @relation("ReferidoDestino", fields: [establecimientoDestinoId], references: [id])
  origen                   Establecimiento @relation("ReferidoOrigen", fields: [establecimientoOrigenId], references: [id])
  historia                 HistoriaClinica @relation(fields: [historiaId], references: [id])

  @@index([establecimientoDestinoId], map: "referidos_establecimientoDestinoId_fkey")
  @@index([establecimientoOrigenId], map: "referidos_establecimientoOrigenId_fkey")
  @@index([historiaId], map: "referidos_historiaId_fkey")
  @@map("referidos")
}

/// Definición de formularios clínicos dinámicos por especialidad
model PlantillaFormulario {
  /// Identificador único
  id             Int                   @id @default(autoincrement())
  /// ID de la especialidad a la que pertenece el formulario
  especialidadId Int
  /// Nombre descriptivo del formulario (ej: Control Prenatal)
  nombre         String                @db.VarChar(150)
  /// Propósito del formulario
  descripcion    String?               @db.Text
  /// Número de versión para control de cambios
  version        Int                   @default(1)
  /// Indica si es la versión que se muestra actualmente
  activa         Boolean               @default(false)
  /// ID del usuario que diseñó la plantilla
  creadoPorId    Int
  /// Fecha de creación
  creadoEn       DateTime              @default(now())
  /// Fecha de última modificación
  actualizadoEn  DateTime              @updatedAt
  historiales    HistoriaClinica[]
  creadoPor      Usuario               @relation(fields: [creadoPorId], references: [id])
  especialidad   Especialidad          @relation(fields: [especialidadId], references: [id])
  respuestas     RespuestaFormulario[]
  secciones      SeccionFormulario[]

  @@unique([especialidadId, version])
  @@index([creadoPorId], map: "plantillas_formulario_creadoPorId_fkey")
  @@map("plantillas_formulario")
}

/// Agrupador de campos dentro de un formulario dinámico
model SeccionFormulario {
  /// Identificador único
  id          Int                 @id @default(autoincrement())
  /// ID de la plantilla padre
  plantillaId Int
  /// Título de la sección
  nombre      String              @db.VarChar(100)
  /// Texto de ayuda para la sección
  descripcion String?             @db.VarChar(300)
  /// Posición relativa en el formulario
  orden       Int                 @default(0)
  /// Indica si la sección se puede contraer en la UI
  colapsable  Boolean             @default(false)
  /// Indica si la sección se muestra por defecto
  visible     Boolean             @default(true)
  campos      CampoFormulario[]
  plantilla   PlantillaFormulario @relation(fields: [plantillaId], references: [id], onDelete: Cascade)

  @@index([plantillaId], map: "secciones_formulario_plantillaId_fkey")
  @@map("secciones_formulario")
}

/// Definición de un campo individual de captura de datos
model CampoFormulario {
  /// Identificador único
  id                   Int               @id @default(autoincrement())
  /// ID de la sección contenedora
  seccionId            Int
  /// Tipo de control de entrada (Texto, Número, etc.)
  tipo                 TipoCampo
  /// Texto que ve el usuario (Label)
  etiqueta             String            @db.VarChar(150)
  /// Nombre técnico del campo para almacenamiento
  clave                String            @db.VarChar(80)
  /// Texto sugerido dentro del campo
  placeholder          String?           @db.VarChar(200)
  /// Texto de ayuda u orientación médica
  ayuda                String?           @db.VarChar(300)
  /// Indica si el campo es obligatorio
  requerido            Boolean           @default(false)
  /// Posición dentro de la sección
  orden                Int               @default(0)
  /// Porcentaje de ancho que ocupa en la pantalla
  ancho                AnchoCampo        @default(COMPLETO)
  /// Indica si el campo es visible inicialmente
  visible              Boolean           @default(true)
  /// Objeto JSON con validaciones u opciones adicionales
  configuracion        Json?
  /// Lógica JSON para mostrar/ocultar según otros campos
  condicionVisibilidad Json?
  seccion              SeccionFormulario @relation(fields: [seccionId], references: [id], onDelete: Cascade)

  @@index([seccionId], map: "campos_formulario_seccionId_fkey")
  @@map("campos_formulario")
}

/// Almacenamiento de los datos capturados en un formulario dinámico
model RespuestaFormulario {
  /// Identificador único
  id            Int                 @id @default(autoincrement())
  /// ID de la historia clínica vinculada
  historiaId    Int                 @unique
  /// ID de la plantilla utilizada
  plantillaId   Int
  /// Objeto JSON con los valores capturados (Clave-Valor)
  respuestas    Json
  /// Indica si se completaron todos los campos requeridos
  completado    Boolean             @default(false)
  /// Fecha de registro de datos
  creadoEn      DateTime            @default(now())
  /// Fecha de última modificación de los datos
  actualizadoEn DateTime            @updatedAt
  historia      HistoriaClinica     @relation(fields: [historiaId], references: [id])
  plantilla     PlantillaFormulario @relation(fields: [plantillaId], references: [id])

  @@index([plantillaId], map: "respuestas_formulario_plantillaId_fkey")
  @@map("respuestas_formulario")
}

/// Evaluación inicial de signos vitales y priorización de atención
model Triaje {
  /// Identificador único
  id                     Int             @id @default(autoincrement())
  /// ID de la cita para la cual se realiza el triaje
  citaId                 Int             @unique
  /// ID del paciente evaluado
  pacienteId             Int
  /// ID de la enfermera que realiza la evaluación
  enfermeraId            Int
  /// Descripción breve del síntoma principal
  motivoConsulta         String          @db.Text
  /// Tensión arterial sistólica (mmHg)
  presionSistolica       Int?
  /// Tensión arterial diastólica (mmHg)
  presionDiastolica      Int?
  /// Latidos por minuto
  frecuenciaCardiaca     Int?
  /// Respiraciones por minuto
  frecuenciaRespiratoria Int?
  /// Temperatura corporal (Â°C)
  temperatura            Decimal?        @db.Decimal(4, 1)
  /// Porcentaje de oxígeno en sangre
  saturacionO2           Int?
  /// Nivel de azúcar en sangre (mg/dL)
  glucometria            Decimal?        @db.Decimal(5, 1)
  /// Peso actual (kg)
  peso                   Decimal?        @db.Decimal(5, 2)
  /// Estatura actual (cm)
  talla                  Decimal?        @db.Decimal(4, 1)
  /// Intensidad del dolor percibido (0-10)
  escalaDolor            Int?
  /// Estado neurológico del paciente
  nivelConciencia        NivelConciencia @default(ALERTA)
  /// Clasificación de prioridad según colores (Manchester/Sistema local)
  categoria              CategoriaTriaje
  /// Hallazgos adicionales de enfermería
  observaciones          String?         @db.Text
  /// Fecha y hora de la evaluación
  creadoEn               DateTime        @default(now())
  cita                   Cita            @relation(fields: [citaId], references: [id])
  enfermera              Usuario         @relation("TriajeEnfermera", fields: [enfermeraId], references: [id])
  paciente               Paciente        @relation(fields: [pacienteId], references: [id])

  @@index([enfermeraId], map: "triajes_enfermeraId_fkey")
  @@index([pacienteId], map: "triajes_pacienteId_fkey")
  @@map("triajes")
}

/// Catálogo oficial de enfermedades CIE-10 (Clasificación Internacional de Enfermedades)
model CatDiagnostico {
  /// Identificador único
  id                    Int     @id @default(autoincrement())
  /// Código alfanumérico estándar (ej: A00.0)
  codigo                String  @unique @db.VarChar(10)
  /// Descripción clínica de la patología
  descripcion           String  @db.VarChar(500)
  /// Grupo o capítulo al que pertenece la enfermedad
  capitulo              String? @db.VarChar(150)
  /// Indica si el diagnóstico está vigente
  activo                Boolean @default(true)
  /// Indica si la enfermedad es de reporte obligatorio a vigilancia
  notificable           Boolean @default(false)
  /// Indica si se debe notificar en menos de 24 horas
  notificacionInmediata Boolean @default(false)

  @@index([codigo])
  @@index([descripcion(length: 100)])
  @@map("cat_diagnostico")
}

/// Registro de trazabilidad de acciones críticas realizadas en el sistema
model AuditLog {
  /// Identificador único
  id         Int      @id @default(autoincrement())
  /// ID del usuario que realizó la acción
  usuarioId  Int?
  /// Tipo de operación (CREATE, UPDATE, DELETE, LOGIN)
  accion     String   @db.VarChar(50)
  /// Nombre de la tabla o entidad afectada
  entidad    String   @db.VarChar(100)
  /// ID del registro específico afectado
  entidadId  Int?
  /// Descripción detallada del cambio o error
  detalle    String?  @db.Text
  /// Dirección IP del cliente
  ip         String?  @db.VarChar(45)
  /// Tiempo de respuesta del servidor en milisegundos
  duracionMs Int?
  /// Fecha y hora exacta del evento
  timestamp  DateTime @default(now())
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([timestamp])
  @@index([usuarioId])
  @@map("audit_logs")
}

/// Configuración global de variables de operación del sistema
model ParametroSistema {
  /// Identificador único
  id            Int      @id @default(autoincrement())
  /// Nombre único de la variable (ej: TIEMPO_SESION)
  clave         String   @unique @db.VarChar(50)
  /// Valor asignado a la configuración
  valor         String   @db.VarChar(500)
  /// Explicación del impacto del parámetro en el sistema
  descripcion   String?  @db.VarChar(200)
  /// Fecha de creación inicial
  creadoEn      DateTime @default(now())
  /// Fecha de última actualización
  actualizadoEn DateTime @updatedAt

  @@map("parametros_sistema")
}

/// Registro de la entrega física de medicamentos al paciente
model Dispensacion {
  /// Identificador único
  id                Int                   @id @default(autoincrement())
  /// ID de la receta que se está surtiendo
  recetaId          Int
  /// ID del usuario de farmacia que entrega
  usuarioId         Int
  /// ID del establecimiento donde ocurre la entrega
  establecimientoId Int
  /// Fecha y hora de la entrega
  fecha             DateTime              @default(now())
  detalles          DispensacionDetalle[]
  establecimiento   Establecimiento       @relation(fields: [establecimientoId], references: [id])
  receta            Receta                @relation(fields: [recetaId], references: [id])
  usuario           Usuario               @relation(fields: [usuarioId], references: [id])

  @@index([establecimientoId], map: "dispensaciones_establecimientoId_fkey")
  @@index([recetaId], map: "dispensaciones_recetaId_fkey")
  @@index([usuarioId], map: "dispensaciones_usuarioId_fkey")
  @@map("dispensaciones")
}

/// Detalle de las unidades entregadas por cada ítem de la receta
model DispensacionDetalle {
  /// Identificador único
  id              Int           @id @default(autoincrement())
  /// ID de la transacción de dispensación
  dispensacionId  Int
  /// ID del renglón de la receta original
  detalleRecetaId Int
  /// ID del registro de inventario (lote) de donde salió el producto
  inventarioId    Int
  /// Cantidad física entregada al paciente
  cantidad        Int
  detalleReceta   DetalleReceta @relation(fields: [detalleRecetaId], references: [id])
  dispensacion    Dispensacion  @relation(fields: [dispensacionId], references: [id])
  inventario      Inventario    @relation(fields: [inventarioId], references: [id])

  @@index([detalleRecetaId], map: "dispensacion_detalles_detalleRecetaId_fkey")
  @@index([dispensacionId], map: "dispensacion_detalles_dispensacionId_fkey")
  @@index([inventarioId], map: "dispensacion_detalles_inventarioId_fkey")
  @@map("dispensacion_detalles")
}

/// Listado de los 18 departamentos de Honduras
model Departamento {
  /// Identificador único (Código INE)
  id               Int               @id
  /// Código alfanumérico de 2 dígitos (ej: 01, 08)
  codigo           String            @unique @db.VarChar(2)
  /// Nombre oficial del departamento
  nombre           String            @unique @db.VarChar(50)
  establecimientos Establecimiento[]
  municipios       Municipio[]
  pacientes        Paciente[]

  @@map("departamentos")
}

/// Listado de los 298 municipios de Honduras
model Municipio {
  /// Identificador único (Código INE de 4 dígitos)
  id               Int               @id
  /// Código alfanumérico de 4 dígitos (ej: 0801)
  codigo           String            @unique @db.VarChar(4)
  /// Nombre oficial del municipio
  nombre           String            @db.VarChar(100)
  /// ID del departamento al que pertenece
  departamentoId   Int
  establecimientos Establecimiento[]
  departamento     Departamento      @relation(fields: [departamentoId], references: [id])
  pacientes        Paciente[]

  @@index([departamentoId], map: "municipios_departamentoId_fkey")
  @@map("municipios")
}

/// Definición de horarios laborales recurrentes de los médicos
model AgendaBase {
  /// Identificador único
  id                Int             @id @default(autoincrement())
  /// ID del médico dueño de la agenda
  medicoId          Int
  /// ID del establecimiento donde labora en este horario
  establecimientoId Int             @default(1)
  /// Día de la semana (0=Domingo, 1=Lunes, ..., 6=Sábado)
  diaSemana         Int
  /// Hora de inicio de la jornada (formato HH:mm)
  horaInicio        String          @db.VarChar(5)
  /// Hora de fin de la jornada (formato HH:mm)
  horaFin           String          @db.VarChar(5)
  /// Indica si este horario está vigente
  activo            Boolean         @default(true)
  /// Fecha de registro de la agenda
  creadoEn          DateTime        @default(now())
  /// Fecha de última modificación de horarios
  actualizadoEn     DateTime        @updatedAt
  establecimiento   Establecimiento @relation(fields: [establecimientoId], references: [id])
  medico            Usuario         @relation("AgendaMedico", fields: [medicoId], references: [id])

  @@unique([medicoId, establecimientoId, diaSemana, horaInicio])
  @@index([establecimientoId], map: "agendas_base_establecimientoId_fkey")
  @@map("agendas_base")
}

/// Registro de ausencias o cambios temporales en la disponibilidad médica
model ExcepcionAgenda {
  /// Identificador único
  id                Int             @id @default(autoincrement())
  /// ID del médico afectado por la excepción
  medicoId          Int
  /// ID del establecimiento donde aplica la excepción
  establecimientoId Int             @default(1)
  /// Motivo de la ausencia (Vacaciones, Incapacidad, etc.)
  tipo              TipoExcepcion
  /// Fecha y hora de inicio de la excepción
  fechaInicio       DateTime
  /// Fecha y hora de fin de la excepción
  fechaFin          DateTime
  /// Descripción detallada o notas administrativas
  descripcion       String?         @db.VarChar(500)
  /// Fecha de registro del evento
  creadoEn          DateTime        @default(now())
  /// ID del usuario que registró la excepción
  creadoPorId       Int?
  establecimiento   Establecimiento @relation(fields: [establecimientoId], references: [id])
  medico            Usuario         @relation("ExcepcionMedico", fields: [medicoId], references: [id])

  @@index([establecimientoId], map: "excepciones_agenda_establecimientoId_fkey")
  @@index([medicoId], map: "excepciones_agenda_medicoId_fkey")
  @@map("excepciones_agenda")
}

/// Catálogo maestro de vacunas autorizadas (Esquema PAI)
model CatVacuna {
  /// Identificador único
  id            Int                  @id @default(autoincrement())
  /// Nombre oficial de la vacuna (ej: BCG, Sabin)
  nombre        String               @unique @db.VarChar(100)
  /// Descripción de la enfermedad que previene
  descripcion   String?              @db.VarChar(500)
  /// Naturaleza biológica de la vacuna
  tipo          TipoVacuna           @default(VIRAL_ATENUADA)
  /// Grupo de edad o condición para la cual está indicada
  poblacionMeta String?              @db.VarChar(100)
  /// Indica si la vacuna está vigente en el esquema nacional
  activo        Boolean              @default(true)
  /// Fecha de registro en el catálogo
  creadoEn      DateTime             @default(now())
  esquemas      EsquemaVacunacion[]
  lotes         LoteVacuna[]
  registros     VacunacionRegistro[]

  @@map("cat_vacunas")
}

/// Definición de las dosis y tiempos de aplicación por cada vacuna
model EsquemaVacunacion {
  /// Identificador único
  id                   Int                  @id @default(autoincrement())
  /// ID de la vacuna asociada
  vacunaId             Int
  /// Orden de la dosis (1=Primera, 2=Segunda, 3=Tercera, 4=Refuerzo)
  numeroDosis          Int
  /// Edad ideal del paciente en meses para la dosis
  edadRecomendadaMeses Int
  /// Tiempo mínimo de espera desde la dosis previa
  intervaloMinimoDias  Int?
  /// Notas sobre la aplicación (ej: Dosis única)
  descripcion          String?              @db.VarChar(200)
  vacuna               CatVacuna            @relation(fields: [vacunaId], references: [id])
  registros            VacunacionRegistro[]

  @@unique([vacunaId, numeroDosis])
  @@map("esquemas_vacunacion")
}

/// Gestión de lotes específicos de vacunas y su inventario
model LoteVacuna {
  /// Identificador único
  id                Int                  @id @default(autoincrement())
  /// ID de la vacuna
  vacunaId          Int
  /// Código alfanumérico del lote (fabricante)
  codigoLote        String               @db.VarChar(50)
  /// Laboratorio productor del biológico
  fabricante        String?              @db.VarChar(100)
  /// Fecha de caducidad del lote
  fechaVencimiento  DateTime
  /// Cantidad de dosis recibidas originalmente
  cantidadInicial   Int
  /// Dosis disponibles actualmente
  cantidadActual    Int
  /// ID del establecimiento custodio del lote
  establecimientoId Int
  /// Indica si el lote puede ser utilizado
  activo            Boolean              @default(true)
  /// Fecha de registro en el sistema
  creadoEn          DateTime             @default(now())
  establecimiento   Establecimiento      @relation(fields: [establecimientoId], references: [id])
  vacuna            CatVacuna            @relation(fields: [vacunaId], references: [id])
  movimientos       MovimientoVacuna[]
  registros         VacunacionRegistro[]

  @@unique([establecimientoId, vacunaId, codigoLote])
  @@index([vacunaId], map: "lotes_vacunas_vacunaId_fkey")
  @@map("lotes_vacunas")
}

/// Registro detallado de transacciones físicas de biológicos
model MovimientoVacuna {
  /// Identificador único
  id        Int                  @id @default(autoincrement())
  /// ID del lote afectado
  loteId    Int
  /// Tipo de transacción de inventario
  tipo      TipoMovimientoVacuna
  /// Número de dosis (positivo para ingresos, negativo para egresos)
  cantidad  Int
  /// Explicación del movimiento
  motivo    String?              @db.VarChar(200)
  /// ID del usuario que registró la transacción
  usuarioId Int
  /// Fecha y hora del registro
  fecha     DateTime             @default(now())
  lote      LoteVacuna           @relation(fields: [loteId], references: [id])
  usuario   Usuario              @relation(fields: [usuarioId], references: [id])

  @@index([loteId], map: "movimientos_vacunas_loteId_fkey")
  @@index([usuarioId], map: "movimientos_vacunas_usuarioId_fkey")
  @@map("movimientos_vacunas")
}

/// Registro histórico de la aplicación de una dosis a un paciente
model VacunacionRegistro {
  /// Identificador único
  id                Int                @id @default(autoincrement())
  /// ID del paciente inmunizado
  pacienteId        Int
  /// ID de la vacuna aplicada
  vacunaId          Int
  /// ID de la dosis dentro del esquema (si aplica)
  esquemaId         Int?
  /// ID del lote físico utilizado
  loteId            Int
  /// Fecha y hora de la aplicación
  fechaAplicacion   DateTime           @default(now())
  /// Lugar anatómico (ej: Brazo derecho)
  sitioAplicacion   String?            @db.VarChar(50)
  /// Técnica utilizada (ej: Intramuscular)
  viaAplicacion     String?            @db.VarChar(50)
  /// Notas sobre reacciones adversas o incidentes
  observaciones     String?            @db.Text
  /// Establecimiento donde se aplicó
  establecimientoId Int
  /// Usuario (enfermera/médico) que administró la dosis
  aplicadoPorId     Int
  aplicadoPor       Usuario            @relation(fields: [aplicadoPorId], references: [id])
  esquema           EsquemaVacunacion? @relation(fields: [esquemaId], references: [id])
  establecimiento   Establecimiento    @relation(fields: [establecimientoId], references: [id])
  lote              LoteVacuna         @relation(fields: [loteId], references: [id])
  paciente          Paciente           @relation(fields: [pacienteId], references: [id])
  vacuna            CatVacuna          @relation(fields: [vacunaId], references: [id])

  @@index([aplicadoPorId], map: "registros_vacunacion_aplicadoPorId_fkey")
  @@index([esquemaId], map: "registros_vacunacion_esquemaId_fkey")
  @@index([establecimientoId], map: "registros_vacunacion_establecimientoId_fkey")
  @@index([loteId], map: "registros_vacunacion_loteId_fkey")
  @@index([pacienteId], map: "registros_vacunacion_pacienteId_fkey")
  @@index([vacunaId], map: "registros_vacunacion_vacunaId_fkey")
  @@map("registros_vacunacion")
}

/// Reporte de enfermedades de vigilancia obligatoria para salud pública
model NotificacionEpidemiologica {
  /// Identificador único
  id                  Int             @id @default(autoincrement())
  /// ID del paciente afectado
  pacienteId          Int
  /// ID del encuentro clínico donde se detectó
  historiaId          Int             @unique
  /// Código CIE-10 de la enfermedad sospechosa/confirmada
  diagnosticoCIE10    String          @db.VarChar(10)
  /// Coordenada geográfica (Eje Y) para mapas de calor
  latitud             Decimal?        @db.Decimal(10, 8)
  /// Coordenada geográfica (Eje X) para mapas de calor
  longitud            Decimal?        @db.Decimal(11, 8)
  /// Croquis o puntos de referencia del domicilio
  direccionDetallada  String?         @db.Text
  /// Fecha estimada del primer síntoma reportado
  fechaInicioSintomas DateTime?       @db.Date
  /// Historial de desplazamientos recientes del paciente
  antecedentesViaje   String?         @db.Text
  /// Centros poblados o áreas visitadas
  lugaresVisitados    String?         @db.Text
  /// Información epidemiológica adicional
  observaciones       String?         @db.Text
  /// Fecha de creación del reporte
  creadoEn            DateTime        @default(now())
  /// ID del médico que detectó el caso
  creadoPorId         Int?
  /// Estado del proceso de investigación (PENDIENTE, NOTIFICADO)
  estado              String          @default("PENDIENTE")
  /// Fecha de cierre o escalamiento de la investigación
  gestionadoEn        DateTime?
  /// ID del epidemiólogo que validó el caso
  gestionadoPorId     Int?
  creadoPor           Usuario?        @relation("NotificacionCreadaPor", fields: [creadoPorId], references: [id])
  gestionadoPor       Usuario?        @relation("GestionadoPor", fields: [gestionadoPorId], references: [id])
  historia            HistoriaClinica @relation(fields: [historiaId], references: [id])
  paciente            Paciente        @relation(fields: [pacienteId], references: [id])

  @@index([creadoPorId], map: "notificaciones_epidemiologicas_creadoPorId_fkey")
  @@index([gestionadoPorId], map: "notificaciones_epidemiologicas_gestionadoPorId_fkey")
  @@index([pacienteId], map: "notificaciones_epidemiologicas_pacienteId_fkey")
  @@map("notificaciones_epidemiologicas")
}

/// Representa el ingreso de un paciente a una cama del hospital
model IngresoHospitalario {
  /// Identificador único
  id                 Int                      @id @default(autoincrement())
  /// ID del paciente que ingresa
  pacienteId         Int
  /// ID de la cama asignada
  camaId             Int
  /// ID del servicio que lo admite
  servicioId         Int
  /// Fecha y hora de ingreso
  fechaIngreso       DateTime                 @default(now())
  /// Motivo clínico del ingreso
  motivoIngreso      String                   @db.Text
  /// Código CIE-10 presuntivo
  cie10Ingreso       String?                  @db.VarChar(10)
  /// Descripción del diagnóstico presuntivo
  diagnosticoIngreso String?                  @db.VarChar(500)
  /// ID del médico que autoriza el ingreso
  medicoIngresoId    Int
  /// Estado actual del internamiento
  estado             EstadoHospitalizacion    @default(ACTIVO)
  /// Fecha de registro en el sistema
  creadoEn           DateTime                 @default(now())
  /// ID del usuario que registró el ingreso (admisionista)
  creadoPorId        Int
  controlSignos      ControlSignosVitales[]
  egreso             EgresoHospitalario?
  cama               Cama                     @relation(fields: [camaId], references: [id])
  medicoIngreso      Usuario                  @relation("MedicoIngreso", fields: [medicoIngresoId], references: [id])
  paciente           Paciente                 @relation(fields: [pacienteId], references: [id])
  servicio           Servicio                 @relation(fields: [servicioId], references: [id])
  kardexMedicamentos KardexMedicamento[]
  movimientos        MovimientoHospitalario[]
  notasEvolucion     NotaEvolucion[]

  @@index([camaId], map: "ingresos_hospitalarios_camaId_fkey")
  @@index([medicoIngresoId], map: "ingresos_hospitalarios_medicoIngresoId_fkey")
  @@index([pacienteId], map: "ingresos_hospitalarios_pacienteId_fkey")
  @@index([servicioId], map: "ingresos_hospitalarios_servicioId_fkey")
  @@map("ingresos_hospitalarios")
}

/// Registro de administración de medicamentos (Kardex)
model KardexMedicamento {
  id              Int                  @id @default(autoincrement())
  ingresoId       Int
  medicamentoId   Int
  dosis           String               @db.VarChar(100)
  via             String?              @db.VarChar(50)
  fechaProgramada DateTime
  fechaAplicacion DateTime?
  estado          EstadoAdministracion @default(PENDIENTE)
  observaciones   String?              @db.Text
  enfermeraId     Int
  enfermera       Usuario              @relation(fields: [enfermeraId], references: [id])
  ingreso         IngresoHospitalario  @relation(fields: [ingresoId], references: [id])
  medicamento     Medicamento          @relation(fields: [medicamentoId], references: [id])

  @@index([enfermeraId], map: "kardex_medicamentos_enfermeraId_fkey")
  @@index([ingresoId], map: "kardex_medicamentos_ingresoId_fkey")
  @@index([medicamentoId], map: "kardex_medicamentos_medicamentoId_fkey")
  @@map("kardex_medicamentos")
}

/// Registro frecuente de signos vitales por enfermería
model ControlSignosVitales {
  id                     Int                 @id @default(autoincrement())
  ingresoId              Int
  fecha                  DateTime            @default(now())
  frecuenciaCardiaca     Int?
  frecuenciaRespiratoria Int?
  presionArterial        String?             @db.VarChar(20)
  temperatura            Decimal?            @db.Decimal(4, 2)
  saturacionOxigeno      Int?
  pesoKg                 Decimal?            @db.Decimal(5, 2)
  glucoMetria            Int?
  observaciones          String?             @db.Text
  usuarioId              Int
  ingreso                IngresoHospitalario @relation(fields: [ingresoId], references: [id])
  usuario                Usuario             @relation(fields: [usuarioId], references: [id])

  @@index([ingresoId], map: "control_signos_vitales_ingresoId_fkey")
  @@index([usuarioId], map: "control_signos_vitales_usuarioId_fkey")
  @@map("control_signos_vitales")
}

/// Registro cronológico del progreso médico de un paciente hospitalizado
model NotaEvolucion {
  /// Identificador único
  id                     Int                 @id @default(autoincrement())
  /// ID del ingreso hospitalario al que pertenece la nota
  ingresoId              Int
  /// Fecha y hora de la evaluación
  fecha                  DateTime            @default(now())
  /// Relato médico de la evolución
  nota                   String              @db.Text
  frecuenciaCardiaca     Int?
  frecuenciaRespiratoria Int?
  presionArterial        String?             @db.VarChar(20)
  temperatura            Decimal?            @db.Decimal(4, 2)
  saturacionOxigeno      Int?
  /// ID del médico que realiza la nota
  medicoId               Int
  ingreso                IngresoHospitalario @relation(fields: [ingresoId], references: [id])
  medico                 Usuario             @relation(fields: [medicoId], references: [id])

  @@index([ingresoId], map: "notas_evolucion_ingresoId_fkey")
  @@index([medicoId], map: "notas_evolucion_medicoId_fkey")
  @@map("notas_evolucion")
}

/// Representa el alta o egreso de un paciente hospitalizado
model EgresoHospitalario {
  /// Identificador único
  id              Int                 @id @default(autoincrement())
  /// ID del ingreso asociado
  ingresoId       Int                 @unique
  /// Fecha y hora de egreso
  fechaEgreso     DateTime            @default(now())
  /// Tipo de egreso (Alta médica, Traslado, Fallecimiento, Voluntario)
  tipoEgreso      TipoEgreso
  /// Condición del paciente al egreso
  condicionEgreso String              @db.Text
  /// Código CIE-10 final o de egreso
  cie10Egreso     String?             @db.VarChar(10)
  /// Resumen clínico final (Epicrisis)
  epicrisis       String?             @db.Text
  /// ID del médico que da el alta
  medicoEgresoId  Int
  ingreso         IngresoHospitalario @relation(fields: [ingresoId], references: [id])
  medicoEgreso    Usuario             @relation("MedicoEgreso", fields: [medicoEgresoId], references: [id])

  @@index([medicoEgresoId], map: "egresos_hospitalarios_medicoEgresoId_fkey")
  @@map("egresos_hospitalarios")
}

/// Historial de movimientos de cama de un paciente dentro de una misma hospitalización
model MovimientoHospitalario {
  /// Identificador único
  id              Int                 @id @default(autoincrement())
  /// ID del ingreso hospitalario
  ingresoId       Int
  /// ID de la cama de origen
  camaOrigenId    Int
  /// ID de la cama de destino
  camaDestinoId   Int
  /// Fecha y hora del traslado
  fechaMovimiento DateTime            @default(now())
  /// Motivo del traslado (ej: empeoramiento, paso a cuidados intermedios)
  motivo          String?             @db.VarChar(250)
  /// ID del usuario que realizó el traslado en el sistema
  usuarioId       Int
  camaDestino     Cama                @relation("CamaDestino", fields: [camaDestinoId], references: [id])
  camaOrigen      Cama                @relation("CamaOrigen", fields: [camaOrigenId], references: [id])
  ingreso         IngresoHospitalario @relation(fields: [ingresoId], references: [id])

  @@index([camaDestinoId], map: "movimientos_hospitalarios_camaDestinoId_fkey")
  @@index([camaOrigenId], map: "movimientos_hospitalarios_camaOrigenId_fkey")
  @@index([ingresoId], map: "movimientos_hospitalarios_ingresoId_fkey")
  @@map("movimientos_hospitalarios")
}

/// Representa las imágenes que se muestran en el carrusel de la pantalla de login
model ImagenLogin {
  /// Identificador único
  id            Int      @id @default(autoincrement())
  /// Nombre descriptivo de la imagen
  nombre        String   @db.VarChar(100)
  /// Título opcional que se muestra sobre la imagen
  titulo        String?  @db.VarChar(100)
  /// Descripción opcional que se muestra sobre la imagen
  descripcion   String?  @db.VarChar(300)
  /// Tipo de contenido (image/jpeg, image/png, etc.)
  mimetype      String   @db.VarChar(50)
  /// Datos binarios de la imagen
  datos         Bytes    @db.MediumBlob
  /// Indica si la imagen está activa para mostrarse
  activo        Boolean  @default(true)
  /// Orden de aparición en el carrusel
  orden         Int      @default(0)
  /// Fecha de registro
  creadoEn      DateTime @default(now())
  /// Fecha de última actualización
  actualizadoEn DateTime @updatedAt

  @@map("imagenes_login")
}

model Configuracion {
  id            Int      @id @default(1)
  nombreSistema String   @default("Sistema Integral de Servicios de Salud") @map("nombre_sistema")
  logo          Bytes?   @db.MediumBlob
  logoMimetype  String?  @map("logo_mimetype")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  siglasSistema String   @default("SISS") @map("siglas_sistema")

  @@map("configuraciones")
}

/// Modelo para cuentas de usuario de PACIENTES (Móvil)
/// Separa los usuarios institucionales de los ciudadanos
model PacienteUsuario {
  id                       Int              @id @default(autoincrement())
  /// ID del paciente vinculado (opcional hasta que se cree el expediente clínico)
  pacienteId               Int?             @unique
  /// Correo electrónico (identificador para login)
  correo                   String           @unique @db.VarChar(150)
  /// Hash de la contraseña
  contrasenaHash           String           @db.VarChar(255)
  /// Estado de la cuenta
  activo                   Boolean          @default(true)
  /// Indica si requiere cambio de contraseña (ej. primer login)
  requiereCambioContrasena Boolean          @default(true)
  /// Fecha del último acceso
  ultimoAcceso             DateTime?
  /// Fecha de creación
  creadoEn                 DateTime         @default(now())
  /// Fecha de última actualización
  actualizadoEn            DateTime         @updatedAt
  /// Documento Nacional de Identificación
  dni                      String           @unique @db.VarChar(13)
  paciente                 Paciente?        @relation(fields: [pacienteId], references: [id])
  sesiones                 SesionPaciente[]

  @@map("pacientes_usuarios")
}

/// Sesiones específicas para usuarios móviles
model SesionPaciente {
  id                Int             @id @default(autoincrement())
  pacienteUsuarioId Int
  refreshTokenHash  String          @db.VarChar(255)
  expiresAt         DateTime
  ip                String?         @db.VarChar(45)
  userAgent         String?         @db.VarChar(255)
  creadoEn          DateTime        @default(now())
  usuario           PacienteUsuario @relation(fields: [pacienteUsuarioId], references: [id])

  @@index([pacienteUsuarioId], map: "sesiones_pacientes_pacienteUsuarioId_fkey")
  @@map("sesiones_pacientes")
}

/// Representa el ciclo de vida de un embarazo en el sistema
model Embarazo {
  id             Int                      @id @default(autoincrement())
  pacienteId     Int
  /// Fecha de Captación (UTC Literal)
  fechaCaptacion DateTime                 @default(now())
  /// Fecha de Última Menstruación (UTC Literal)
  fum            DateTime?
  /// Fecha Probable de Parto (Calculada - UTC Literal)
  fpp            DateTime?
  /// Estado actual de la gestación
  estado         EstadoEmbarazo           @default(ACTIVO)
  /// Clasificación de riesgo clínico
  riesgo         RiesgoObstetrico         @default(BAJO)
  observaciones  String?                  @db.Text
  /// ID del usuario que registró el embarazo
  creadoPorId    Int
  /// ID del usuario que realizó la última actualización
  actualizadoPorId Int?
  /// ID del usuario que realizó la eliminación lógica
  eliminadoPorId Int?
  /// Fecha en que finalizó el embarazo (Parto, Aborto, etc.)
  fechaTerminacion DateTime?
  /// Indica si es un embarazo de gemelos, trillizos, etc.
  esMultiple      Boolean                  @default(false)
  /// Cantidad de fetos identificados
  cantidadFetos   Int                      @default(1)
  
  paciente       Paciente                 @relation(fields: [pacienteId], references: [id])
  antecedentes   AntecedentesObstetricos?
  controles      ControlPrenatal[]
  creadoPor      Usuario                  @relation("EmbarazoCreadoPor", fields: [creadoPorId], references: [id])
  actualizadoPor Usuario?                 @relation("EmbarazoActualizadoPor", fields: [actualizadoPorId], references: [id])
  eliminadoPor   Usuario?                 @relation("EmbarazoEliminadoPor", fields: [eliminadoPorId], references: [id])

  @@index([pacienteId], map: "embarazos_pacienteId_fkey")
  @@map("embarazos")
}

/// Antecedentes obstétricos históricos de la paciente (HCPB)
model AntecedentesObstetricos {
  id                    Int      @id @default(autoincrement())
  embarazoId            Int      @unique
  /// Número de gestas totales
  gravidez              Int      @default(0)
  /// Partos vaginales
  partos                Int      @default(0)
  /// Abortos
  abortos               Int      @default(0)
  /// Cesáreas
  cesareas              Int      @default(0)
  /// Óbitos (muertes fetales)
  obitos                Int      @default(0)
  /// Año del último embarazo previo
  ultimoEmbarazoPrevio  Int?
  /// Descripción de complicaciones en embarazos anteriores
  complicacionesPrevias String?  @db.Text
  
  /// Auditoría
  creadoPorId           Int
  actualizadoPorId      Int?
  
  embarazo              Embarazo @relation(fields: [embarazoId], references: [id])
  creadoPor             Usuario  @relation("AntecedentesCreadoPor", fields: [creadoPorId], references: [id])
  actualizadoPor        Usuario? @relation("AntecedentesActualizadoPor", fields: [actualizadoPorId], references: [id])

  @@map("embarazos_antecedentes")
}

/// Registro detallado de cada control prenatal realizado
model ControlPrenatal {
  id                 Int              @id @default(autoincrement())
  embarazoId         Int
  historiaClinicaId  Int?             @unique
  /// Semanas de gestación al momento del control
  semanasGestacion   Decimal          @db.Decimal(4, 1)
  /// Peso materno en kg
  peso               Decimal          @db.Decimal(5, 2)
  /// Tensión Arterial Sistólica (mmHg)
  taSistolica        Int
  /// Tensión Arterial Diastólica (mmHg)
  taDiastolica       Int
  /// Altura Uterina en cm
  alturaUterina      Int?
  /// Latidos por minuto del feto
  fcf                Int?
  /// Presencia de movimientos fetales
  movimientosFetales Boolean?
  /// Datos adicionales para embarazos múltiples (arreglo de fetos)
  /// Estructura: [{ fcf: number, movimientos: boolean }]
  datosFetos         Json?
  /// Presencia de edema
  edema              Boolean          @default(false)
  /// Presencia de proteinuria (Prueba rápida)
  proteinuria        Boolean          @default(false)
  observaciones      String?          @db.Text
  /// Fecha del control (UTC Literal)
  fechaControl       DateTime         @default(now())
  
  /// Auditoría
  creadoPorId        Int
  actualizadoPorId   Int?
  
  embarazo           Embarazo         @relation(fields: [embarazoId], references: [id])
  historiaClinica    HistoriaClinica? @relation(fields: [historiaClinicaId], references: [id])
  creadoPor          Usuario          @relation("ControlPrenatalCreadoPor", fields: [creadoPorId], references: [id])
  actualizadoPor     Usuario?         @relation("ControlPrenatalActualizadoPor", fields: [actualizadoPorId], references: [id])

  @@index([embarazoId], map: "embarazos_controles_embarazoId_fkey")
  @@map("embarazos_controles")
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

/// Clasificación oficial de establecimientos de salud en Honduras
enum TipoEstablecimiento {
  /// Hospital de referencia nacional
  HOSPITAL_NACIONAL
  /// Hospital departamental o regional
  HOSPITAL_REGIONAL
  /// Centro de salud con atención médica
  CENTRO_SALUD
  /// Clínica de atención de emergencias periférica
  CLINICA_PERIFERICA
  /// Centro de Salud con Médico y Odontólogo
  CESAMO
  /// Centro de Salud Rural
  CESAR
}

/// Estados operativos posibles de una cama
enum EstadoCama {
  /// Lista para recibir paciente
  DISPONIBLE
  /// Con paciente asignado
  OCUPADA
  /// Apartada para un ingreso próximo
  RESERVADA
  /// Fuera de servicio por desperfecto
  MANTENIMIENTO
  /// En proceso de desinfección/limpieza
  LIMPIEZA
}

/// Clasificación del tipo de alérgeno
enum TipoAlergia {
  /// Reacción a fármacos
  MEDICAMENTO
  /// Reacción a comidas
  ALIMENTO
  /// Reacción a factores del entorno
  AMBIENTAL
  /// Reacción específica al látex
  LATEX
  /// Otros tipos de alergias
  OTRO
}

/// Escala de severidad de la reacción alérgica
enum Severidad {
  /// Reacción leve, no compromete la vida
  LEVE
  /// Reacción que requiere tratamiento médico moderado
  MODERADA
  /// Reacción anafiláctica o de alto riesgo
  SEVERA
}

/// Clasificación del tipo de encuentro médico
enum TipoCita {
  /// Consulta médica general
  CONSULTA_GENERAL
  /// Consulta con médico especialista
  ESPECIALIDAD
  /// Cita de seguimiento o control
  CONTROL
  /// Atención inmediata por urgencia
  URGENCIA
  /// Cita para aplicación de vacunas
  VACUNACION
  /// Consulta de salud reproductiva
  PLANIFICACION
}

/// Estados posibles en el ciclo de vida de una cita
enum EstadoCita {
  /// Cita registrada pero pendiente de confirmación/llegada
  PROGRAMADA
  /// El paciente ha confirmado su asistencia
  CONFIRMADA
  /// El encuentro médico ha concluido exitosamente
  ATENDIDA
  /// La cita ha sido anulada por el paciente o el centro
  CANCELADA
