  solicitud SolicitudLaboratorio @relation(fields: [solicitudId], references: [id])
  /// Relación con el catálogo de exámenes
  examen    CatExamenLaboratorio @relation(fields: [examenId], references: [id])

  @@map("detalles_solicitud_laboratorio")
}

/// Estados del flujo de trabajo del laboratorio
enum EstadoLab {
  /// Orden emitida por el médico
  SOLICITADO
  /// Muestras tomadas o en análisis
  EN_PROCESO
  /// Resultados validados y disponibles
  COMPLETADO
  /// Orden anulada
  CANCELADO
}

/// Registro de resultados numéricos o cualitativos de exámenes de laboratorio
model ResultadoLaboratorio {
  /// Identificador único
  id              Int      @id @default(autoincrement())
  /// ID de la solicitud a la que pertenece el resultado
  solicitudId     Int
  /// ID opcional de la historia clínica para vinculación directa
  historiaId      Int?
  /// Nombre del parámetro o prueba analizada
  prueba          String   @db.VarChar(200)
  /// Resultado obtenido
  valor           String   @db.VarChar(200)
  /// Unidad de medida (ej: mg/dL, %)
  unidad          String?  @db.VarChar(50)
  /// Rango esperado para un paciente sano
  valorReferencia String?  @db.VarChar(100)
  /// Indica si el valor está fuera de los rangos normales
  anormal         Boolean  @default(false)
  /// Interpretación del microbiólogo o analista
  observaciones   String?  @db.Text
  /// Fecha y hora de validación del resultado
  fecha           DateTime @default(now())

  /// Relación con la solicitud cabecera
  solicitud SolicitudLaboratorio @relation(fields: [solicitudId], references: [id])
  /// Relación con la historia clínica
  historia  HistoriaClinica?     @relation(fields: [historiaId], references: [id])

  @@map("resultados_laboratorio")
}

