// =============================================
// AGENDAS MÃDICAS
// =============================================

/// Definición de horarios laborales recurrentes de los médicos
model AgendaBase {
  /// Identificador único
  id                Int      @id @default(autoincrement())
  /// ID del médico dueño de la agenda
  medicoId          Int
  /// ID del establecimiento donde labora en este horario
  establecimientoId Int      @default(1)
  /// Día de la semana (0=Domingo, 1=Lunes, ..., 6=Sábado)
  diaSemana         Int
  /// Hora de inicio de la jornada (formato HH:mm)
  horaInicio        String   @db.VarChar(5)
  /// Hora de fin de la jornada (formato HH:mm)
  horaFin           String   @db.VarChar(5)
  /// Indica si este horario está vigente
  activo            Boolean  @default(true)
  /// Fecha de registro de la agenda
  creadoEn          DateTime @default(now())
  /// Fecha de última modificación de horarios
  actualizadoEn     DateTime @updatedAt

  /// Relación con el usuario médico
  medico          Usuario         @relation("AgendaMedico", fields: [medicoId], references: [id])
  /// Relación con el establecimiento
  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])

  @@unique([medicoId, establecimientoId, diaSemana, horaInicio])
  @@map("agendas_base")
}

/// Registro de ausencias o cambios temporales en la disponibilidad médica
model ExcepcionAgenda {
  /// Identificador único
  id                Int           @id @default(autoincrement())
  /// ID del médico afectado por la excepción
  medicoId          Int
  /// ID del establecimiento donde aplica la excepción
  establecimientoId Int           @default(1)
  /// Motivo de la ausencia (Vacaciones, Incapacidad, etc.)
  tipo              TipoExcepcion
  /// Fecha y hora de inicio de la excepción
  fechaInicio       DateTime
  /// Fecha y hora de fin de la excepción
  fechaFin          DateTime
  /// Descripción detallada o notas administrativas
  descripcion       String?       @db.VarChar(500)
  /// Fecha de registro del evento
  creadoEn          DateTime      @default(now())
  /// ID del usuario que registró la excepción
  creadoPorId       Int?

  /// Relación con el usuario médico
  medico          Usuario         @relation("ExcepcionMedico", fields: [medicoId], references: [id])
  /// Relación con el establecimiento
  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])

  @@map("excepciones_agenda")
}

/// Clasificación de los motivos de ausencia médica
enum TipoExcepcion {
  /// Período de descanso anual
  VACACIONES_NORMALES
  /// Descanso obligatorio por exposición a riesgos (ej: Rayos X)
  VACACIONES_PROFILACTICAS
  /// Ausencia por eventos de educación médica continua
  CURSO_CONGRESO
  /// Ausencia justificada por enfermedad propia
  INCAPACIDAD
  /// Permiso con o sin goce de sueldo para asuntos personales
  PERMISO_PERSONAL
  /// Otros motivos de ausencia
  OTRO
}

// =============================================
// MÃDULO DE VACUNACIÃN (Estándar PAI SESAL)
// =============================================

/// Catálogo maestro de vacunas autorizadas (Esquema PAI)
model CatVacuna {
  /// Identificador único
  id            Int        @id @default(autoincrement())
  /// Nombre oficial de la vacuna (ej: BCG, Sabin)
  nombre        String     @unique @db.VarChar(100)
  /// Descripción de la enfermedad que previene
  descripcion   String?    @db.VarChar(500)
  /// Naturaleza biológica de la vacuna
  tipo          TipoVacuna @default(VIRAL_ATENUADA)
  /// Grupo de edad o condición para la cual está indicada
  poblacionMeta String?    @db.VarChar(100)
  /// Indica si la vacuna está vigente en el esquema nacional
  activo        Boolean    @default(true)
  /// Fecha de registro en el catálogo
  creadoEn      DateTime   @default(now())

  /// Definiciones de dosis para esta vacuna
  esquemas  EsquemaVacunacion[]
  /// Lotes físicos recibidos de esta vacuna
  lotes     LoteVacuna[]
  /// Registros históricos de aplicaciones
  registros VacunacionRegistro[]

  @@map("cat_vacunas")
}

/// Clasificación biológica de los biológicos
enum TipoVacuna {
  /// Virus vivos debilitados
  VIRAL_ATENUADA
  /// Virus muertos o inactivados
  VIRAL_INACTIVADA
  /// Bacterias vivas debilitadas
  BACTERIANA_ATENUADA
  /// Bacterias muertas o inactivadas
  BACTERIANA_INACTIVADA
  /// Ingeniería genética (ej: Hepatitis B)
  RECOMBINANTE
  /// Tecnología de ARN (ej: COVID-19)
  ARN_MENSAJERO
  /// Basadas en toxinas bacterianas (ej: Tétanos)
  TOXOIDE
}

/// Definición de las dosis y tiempos de aplicación por cada vacuna
model EsquemaVacunacion {
  /// Identificador único
  id                   Int     @id @default(autoincrement())
  /// ID de la vacuna asociada
  vacunaId             Int
  /// Orden de la dosis (1=Primera, 2=Segunda, 3=Tercera, 4=Refuerzo)
  numeroDosis          Int
  /// Edad ideal del paciente en meses para la dosis
  edadRecomendadaMeses Int
  /// Tiempo mínimo de espera desde la dosis previa
  intervaloMinimoDias  Int?
  /// Notas sobre la aplicación (ej: Dosis única)
  descripcion          String? @db.VarChar(200)

  /// Relación con la vacuna
  vacuna    CatVacuna            @relation(fields: [vacunaId], references: [id])
  /// Registros de pacientes que han recibido esta dosis específica
  registros VacunacionRegistro[]

  @@unique([vacunaId, numeroDosis])
  @@map("esquemas_vacunacion")
}

/// Gestión de lotes específicos de vacunas y su inventario
model LoteVacuna {
  /// Identificador único
  id                Int      @id @default(autoincrement())
  /// ID de la vacuna
  vacunaId          Int
  /// Código alfanumérico del lote (fabricante)
  codigoLote        String   @db.VarChar(50)
  /// Laboratorio productor del biológico
  fabricante        String?  @db.VarChar(100)
  /// Fecha de caducidad del lote
  fechaVencimiento  DateTime
  /// Cantidad de dosis recibidas originalmente
  cantidadInicial   Int
  /// Dosis disponibles actualmente
  cantidadActual    Int
  /// ID del establecimiento custodio del lote
  establecimientoId Int
  /// Indica si el lote puede ser utilizado
  activo            Boolean  @default(true)
  /// Fecha de registro en el sistema
  creadoEn          DateTime @default(now())

  /// Relación con la vacuna
  vacuna          CatVacuna            @relation(fields: [vacunaId], references: [id])
  /// Relación con el establecimiento
  establecimiento Establecimiento      @relation(fields: [establecimientoId], references: [id])
  /// Aplicaciones realizadas con este lote
  registros       VacunacionRegistro[]
  /// Historial de movimientos (ingresos, pérdidas) del lote
  movimientos     MovimientoVacuna[]

  @@unique([establecimientoId, vacunaId, codigoLote])
  @@map("lotes_vacunas")
}

/// Registro detallado de transacciones físicas de biológicos
model MovimientoVacuna {
  /// Identificador único
  id        Int                  @id @default(autoincrement())
  /// ID del lote afectado
  loteId    Int
  /// Tipo de transacción de inventario
  tipo      TipoMovimientoVacuna
  /// Número de dosis (positivo para ingresos, negativo para egresos)
  cantidad  Int
  /// Explicación del movimiento
  motivo    String?              @db.VarChar(200)
  /// ID del usuario que registró la transacción
  usuarioId Int
  /// Fecha y hora del registro
  fecha     DateTime             @default(now())

  /// Relación con el lote
  lote    LoteVacuna @relation(fields: [loteId], references: [id])
  /// Relación con el usuario
  usuario Usuario    @relation(fields: [usuarioId], references: [id])

  @@map("movimientos_vacunas")
}

/// Clasificación de transacciones específicas para vacunas
enum TipoMovimientoVacuna {
  /// Recepción de biológicos
  ENTRADA
  /// Traslado a otro establecimiento
  SALIDA
  /// Uso directo en paciente
  APLICACION
  /// Corrección genérica de stock
  AJUSTE
  /// Corrección por sobrantes
  AJUSTE_POSITIVO
  /// Corrección por faltantes
  AJUSTE_NEGATIVO
  /// Pérdida por interrupción de refrigeración
  PERDIDA_CADENA_FRIO
  /// Accidente físico con el vial
  FRASCO_QUEBRADO
  /// El biológico alcanzó su fecha límite
  VENCIMIENTO
}

/// Registro histórico de la aplicación de una dosis a un paciente
model VacunacionRegistro {
  /// Identificador único
  id              Int      @id @default(autoincrement())
  /// ID del paciente inmunizado
  pacienteId      Int
  /// ID de la vacuna aplicada
  vacunaId        Int
  /// ID de la dosis dentro del esquema (si aplica)
  esquemaId       Int?
  /// ID del lote físico utilizado
  loteId          Int
  /// Fecha y hora de la aplicación
  fechaAplicacion DateTime @default(now())
  /// Lugar anatómico (ej: Brazo derecho)
  sitioAplicacion String?  @db.VarChar(50)
  /// Técnica utilizada (ej: Intramuscular)
  viaAplicacion   String?  @db.VarChar(50)
  /// Notas sobre reacciones adversas o incidentes
  observaciones   String?  @db.Text

  /// Establecimiento donde se aplicó
  establecimientoId Int
  /// Usuario (enfermera/médico) que administró la dosis
  aplicadoPorId     Int

  /// Relación con el paciente
  paciente        Paciente           @relation(fields: [pacienteId], references: [id])
  /// Relación con la ficha de la vacuna
  vacuna          CatVacuna          @relation(fields: [vacunaId], references: [id])
  /// Relación con la dosis del esquema
  esquema         EsquemaVacunacion? @relation(fields: [esquemaId], references: [id])
  /// Relación con el lote físico
  lote            LoteVacuna         @relation(fields: [loteId], references: [id])
  /// Relación con el establecimiento
  establecimiento Establecimiento    @relation(fields: [establecimientoId], references: [id])
  /// Relación con el vacunador
  aplicadoPor     Usuario            @relation(fields: [aplicadoPorId], references: [id])

  @@map("registros_vacunacion")
}

// =============================================
// VIGILANCIA EPIDEMIOLÃGICA
// =============================================

/// Reporte de enfermedades de vigilancia obligatoria para salud pública
model NotificacionEpidemiologica {
  /// Identificador único
  id               Int    @id @default(autoincrement())
  /// ID del paciente afectado
  pacienteId       Int
  /// ID del encuentro clínico donde se detectó
  historiaId       Int    @unique
  /// Código CIE-10 de la enfermedad sospechosa/confirmada
  diagnosticoCIE10 String @db.VarChar(10)

  /// Coordenada geográfica (Eje Y) para mapas de calor
  latitud            Decimal? @db.Decimal(10, 8)
  /// Coordenada geográfica (Eje X) para mapas de calor
  longitud           Decimal? @db.Decimal(11, 8)
  /// Croquis o puntos de referencia del domicilio
  direccionDetallada String?  @db.Text

  /// Fecha estimada del primer síntoma reportado
  fechaInicioSintomas DateTime? @db.Date
  /// Historial de desplazamientos recientes del paciente
  antecedentesViaje   String?   @db.Text
  /// Centros poblados o áreas visitadas
  lugaresVisitados    String?   @db.Text
  /// Información epidemiológica adicional
  observaciones       String?   @db.Text

  /// Fecha de creación del reporte
  creadoEn    DateTime @default(now())
  /// ID del médico que detectó el caso
  creadoPorId Int?

  /// Estado del proceso de investigación (PENDIENTE, NOTIFICADO)
  estado          String    @default("PENDIENTE")
  /// Fecha de cierre o escalamiento de la investigación
  gestionadoEn    DateTime?
  /// ID del epidemiólogo que validó el caso
  gestionadoPorId Int?

  /// Relación con el paciente
  paciente      Paciente        @relation(fields: [pacienteId], references: [id])
  /// Relación con la historia clínica
  historia      HistoriaClinica @relation(fields: [historiaId], references: [id])
  /// Relación con el capturador inicial
  creadoPor     Usuario?        @relation("NotificacionCreadaPor", fields: [creadoPorId], references: [id])
  /// Relación con el gestor epidemiológico
  gestionadoPor Usuario?        @relation("GestionadoPor", fields: [gestionadoPorId], references: [id])

  @@map("notificaciones_epidemiologicas")
}

// =============================================
// HOSPITALIZACIÓN (ADMISIÓN Y EGRESO)
// =============================================

/// Representa el ingreso de un paciente a una cama del hospital
model IngresoHospitalario {
  /// Identificador único
  id                 Int                   @id @default(autoincrement())
  /// ID del paciente que ingresa
  pacienteId         Int
  /// ID de la cama asignada
  camaId             Int
  /// ID del servicio que lo admite
  servicioId         Int
  /// Fecha y hora de ingreso
  fechaIngreso       DateTime              @default(now())
  /// Motivo clínico del ingreso
  motivoIngreso      String                @db.Text
  /// Código CIE-10 presuntivo
  cie10Ingreso       String?               @db.VarChar(10)
  /// Descripción del diagnóstico presuntivo
  diagnosticoIngreso String?               @db.VarChar(500)
  /// ID del médico que autoriza el ingreso
  medicoIngresoId    Int
  /// Estado actual del internamiento
  estado             EstadoHospitalizacion @default(ACTIVO)

  /// Fecha de registro en el sistema
  creadoEn    DateTime @default(now())
  /// ID del usuario que registró el ingreso (admisionista)
  creadoPorId Int

  /// Relación con el paciente
  paciente      Paciente                 @relation(fields: [pacienteId], references: [id])
  /// Relación con la cama
  cama          Cama                     @relation(fields: [camaId], references: [id])
  /// Relación con el servicio
  servicio      Servicio                 @relation(fields: [servicioId], references: [id])
  /// Relación con el médico tratante
  medicoIngreso Usuario                  @relation("MedicoIngreso", fields: [medicoIngresoId], references: [id])
  /// Registro de egreso asociado (si ya se dio de alta)
  egreso        EgresoHospitalario?
  /// Historial de movimientos de cama durante la estancia
  movimientos   MovimientoHospitalario[]

  /// Relación con las notas de evolución
  notasEvolucion NotaEvolucion[]

  /// Relación con el Kardex de medicamentos
  kardexMedicamentos KardexMedicamento[]
  /// Relación con el control de signos vitales de enfermería
  controlSignos      ControlSignosVitales[]

  @@map("ingresos_hospitalarios")
}

/// Registro de administración de medicamentos (Kardex)
model KardexMedicamento {
  id              Int                  @id @default(autoincrement())
  ingresoId       Int
  medicamentoId   Int
  dosis           String               @db.VarChar(100)
  via             String?              @db.VarChar(50)
  fechaProgramada DateTime
  fechaAplicacion DateTime?
  estado          EstadoAdministracion @default(PENDIENTE)
  observaciones   String?              @db.Text
  enfermeraId     Int

  ingreso     IngresoHospitalario @relation(fields: [ingresoId], references: [id])
  medicamento Medicamento         @relation(fields: [medicamentoId], references: [id])
  enfermera   Usuario             @relation(fields: [enfermeraId], references: [id])

  @@map("kardex_medicamentos")
}

/// Registro frecuente de signos vitales por enfermería
model ControlSignosVitales {
  id        Int      @id @default(autoincrement())
  ingresoId Int
  fecha     DateTime @default(now())

  frecuenciaCardiaca     Int?
  frecuenciaRespiratoria Int?
  presionArterial        String?  @db.VarChar(20)
  temperatura            Decimal? @db.Decimal(4, 2)
  saturacionOxigeno      Int?
  pesoKg                 Decimal? @db.Decimal(5, 2)
  glucoMetria            Int?

  observaciones String? @db.Text
  usuarioId     Int

  ingreso IngresoHospitalario @relation(fields: [ingresoId], references: [id])
  usuario Usuario             @relation(fields: [usuarioId], references: [id])

  @@map("control_signos_vitales")
}

enum EstadoAdministracion {
  PENDIENTE
  ADMINISTRADO
  OMITIDO
  RECHAZADO
}

/// Registro cronológico del progreso médico de un paciente hospitalizado
model NotaEvolucion {
  /// Identificador único
  id        Int      @id @default(autoincrement())
  /// ID del ingreso hospitalario al que pertenece la nota
  ingresoId Int
  /// Fecha y hora de la evaluación
  fecha     DateTime @default(now())
  /// Relato médico de la evolución
  nota      String   @db.Text

  // Signos vitales en el momento de la evolución (opcionales)
  frecuenciaCardiaca     Int?
  frecuenciaRespiratoria Int?
  presionArterial        String?  @db.VarChar(20)
  temperatura            Decimal? @db.Decimal(4, 2)
  saturacionOxigeno      Int?

  /// ID del médico que realiza la nota
  medicoId Int

  /// Relación con el ingreso
  ingreso IngresoHospitalario @relation(fields: [ingresoId], references: [id])
  /// Relación con el médico (Usuario)
  medico  Usuario             @relation(fields: [medicoId], references: [id])

  @@map("notas_evolucion")
}

/// Representa el alta o egreso de un paciente hospitalizado
model EgresoHospitalario {
  /// Identificador único
  id              Int        @id @default(autoincrement())
  /// ID del ingreso asociado
  ingresoId       Int        @unique
  /// Fecha y hora de egreso
  fechaEgreso     DateTime   @default(now())
  /// Tipo de egreso (Alta médica, Traslado, Fallecimiento, Voluntario)
  tipoEgreso      TipoEgreso
  /// Condición del paciente al egreso
  condicionEgreso String     @db.Text
  /// Código CIE-10 final o de egreso
  cie10Egreso     String?    @db.VarChar(10)
  /// Resumen clínico final (Epicrisis)
  epicrisis       String?    @db.Text
  /// ID del médico que da el alta
  medicoEgresoId  Int

  /// Relación con el ingreso
  ingreso      IngresoHospitalario @relation(fields: [ingresoId], references: [id])
  /// Relación con el médico que firma el alta
  medicoEgreso Usuario             @relation("MedicoEgreso", fields: [medicoEgresoId], references: [id])

  @@map("egresos_hospitalarios")
}

/// Historial de movimientos de cama de un paciente dentro de una misma hospitalización
model MovimientoHospitalario {
  /// Identificador único
  id              Int      @id @default(autoincrement())
  /// ID del ingreso hospitalario
  ingresoId       Int
  /// ID de la cama de origen
  camaOrigenId    Int
  /// ID de la cama de destino
  camaDestinoId   Int
  /// Fecha y hora del traslado
  fechaMovimiento DateTime @default(now())
  /// Motivo del traslado (ej: empeoramiento, paso a cuidados intermedios)
  motivo          String?  @db.VarChar(250)
  /// ID del usuario que realizó el traslado en el sistema
  usuarioId       Int

  /// Relación con el ingreso
  ingreso     IngresoHospitalario @relation(fields: [ingresoId], references: [id])
  /// Relación con la cama de origen
  camaOrigen  Cama                @relation("CamaOrigen", fields: [camaOrigenId], references: [id])
  /// Relación con la cama de destino
  camaDestino Cama                @relation("CamaDestino", fields: [camaDestinoId], references: [id])

  @@map("movimientos_hospitalarios")
}

enum EstadoHospitalizacion {
  ACTIVO
  EGRESADO
  TRASLADADO
  FALLECIDO
}

enum TipoEgreso {
  ALTA_MEDICA
  ALTA_VOLUNTARIA
  TRASLADADO_OTRO_HOSPITAL
  FALLECIMIENTO
  FUGA
}

// =============================================
// CONFIGURACIÓN DE LOGIN
// =============================================

/// Representa las imágenes que se muestran en el carrusel de la pantalla de login
model ImagenLogin {
  /// Identificador único
  id            Int      @id @default(autoincrement())
  /// Nombre descriptivo de la imagen
  nombre        String   @db.VarChar(100)
  /// Título opcional que se muestra sobre la imagen
  titulo        String?  @db.VarChar(100)
  /// Descripción opcional que se muestra sobre la imagen
  descripcion   String?  @db.VarChar(300)
  /// Tipo de contenido (image/jpeg, image/png, etc.)
  mimetype      String   @db.VarChar(50)
  /// Datos binarios de la imagen
  datos         Bytes    @db.MediumBlob
  /// Indica si la imagen está activa para mostrarse
  activo        Boolean  @default(true)
  /// Orden de aparición en el carrusel
  orden         Int      @default(0)
  /// Fecha de registro
  creadoEn      DateTime @default(now())
  /// Fecha de última actualización
  actualizadoEn DateTime @updatedAt

  @@map("imagenes_login")
}

model Configuracion {
  id            Int      @id @default(1)
  siglasSistema String   @default("SISS") @map("siglas_sistema")
  nombreSistema String   @default("Sistema Integral de Servicios de Salud") @map("nombre_sistema")
  logo          Bytes?   @db.MediumBlob
  logoMimetype  String?  @map("logo_mimetype")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("configuraciones")
}

/// Modelo para cuentas de usuario de PACIENTES (Móvil)
/// Separa los usuarios institucionales de los ciudadanos
model PacienteUsuario {
  id                Int       @id @default(autoincrement())
  /// ID del paciente vinculado (opcional hasta que se cree el expediente clínico)
  pacienteId        Int?      @unique
  /// Documento Nacional de Identificación
  dni               String    @unique @db.VarChar(13)
  /// Correo electrónico (identificador para login)
  correo            String    @unique @db.VarChar(150)
  /// Hash de la contraseña
  contrasenaHash    String    @db.VarChar(255)
  /// Estado de la cuenta
  activo            Boolean   @default(true)
  /// Indica si requiere cambio de contraseña (ej. primer login)
  requiereCambioContrasena Boolean @default(true)
  /// Fecha del último acceso
  ultimoAcceso      DateTime?
  /// Fecha de creación
  creadoEn          DateTime  @default(now())
  /// Fecha de última actualización
  actualizadoEn     DateTime  @updatedAt

  /// Relaciones
  paciente          Paciente? @relation(fields: [pacienteId], references: [id])
  sesiones          SesionPaciente[]

  @@map("pacientes_usuarios")
}

/// Sesiones específicas para usuarios móviles
model SesionPaciente {
  id                Int       @id @default(autoincrement())
  pacienteUsuarioId Int
  refreshTokenHash  String    @db.VarChar(255)
  expiresAt         DateTime
  ip                String?   @db.VarChar(45)
  userAgent         String?   @db.VarChar(255)
  creadoEn          DateTime  @default(now())

  usuario           PacienteUsuario @relation(fields: [pacienteUsuarioId], references: [id])

  @@map("sesiones_pacientes")
}
