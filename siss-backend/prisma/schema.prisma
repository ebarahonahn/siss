generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================
// CONTROL DE ACCESO
// =============================================

/// Representa los roles de usuario en el sistema para control de acceso basado en roles (RBAC)
model Rol {
  /// Identificador único autoincremental del rol
  id           Int                 @id @default(autoincrement())
  /// Nombre único del rol (ej: ADMIN, MEDICO, ENFERMERA)
  nombre       String              @unique @db.VarChar(50)
  /// Descripción detallada de las funciones del rol
  descripcion  String?             @db.VarChar(200)
  /// Objeto JSON que define los permisos específicos del rol por módulo
  permisos     Json
  /// Relación con los usuarios que tienen asignado este rol directamente
  usuarios     Usuario[]
  /// Relación con las asignaciones específicas por establecimiento
  asignaciones AsignacionUsuario[]

  @@map("roles")
}

/// Representa a los usuarios del sistema (personal médico, administrativo y de enfermería)
model Usuario {
  /// Identificador único autoincremental del usuario
  id                Int       @id @default(autoincrement())
  /// Número de empleado institucional
  numeroEmpleado    String    @unique @db.VarChar(20)
  /// Nombres del usuario
  nombres           String    @db.VarChar(100)
  /// Apellidos del usuario
  apellidos         String    @db.VarChar(100)
  /// Correo electrónico institucional (usado para login)
  correo            String    @unique @db.VarChar(150)
  /// Hash de la contraseña del usuario (Bcrypt)
  contrasenaHash    String    @db.VarChar(255)
  /// Número de teléfono de contacto
  telefono          String?   @db.VarChar(20)
  /// ID de la especialidad primaria del usuario (si aplica)
  especialidadId    Int?
  /// Número de colegiación profesional (obligatorio para médicos)
  numeroColegiado   String?   @db.VarChar(50)
  /// Indica si el usuario está activo en el sistema
  activo            Boolean   @default(true)
  /// Indica si el usuario debe cambiar su contraseña en el próximo inicio de sesión
  requiereCambioContrasena Boolean @default(false)
  /// Fecha y hora del último acceso exitoso
  ultimoAcceso      DateTime?
  /// ID del rol principal asignado
  rolId             Int?
  /// ID del establecimiento base donde labora
  establecimientoId Int?

  /// Relación con el modelo de Rol
  rol                          Rol?                         @relation(fields: [rolId], references: [id])
  /// Relación con el establecimiento base
  establecimiento              Establecimiento?             @relation(fields: [establecimientoId], references: [id])
  /// Relación con la especialidad profesional
  especialidad                 Especialidad?                @relation(fields: [especialidadId], references: [id])
  /// Historial de asignaciones a diferentes establecimientos y servicios
  asignaciones                 AsignacionUsuario[]
  /// Sesiones activas e históricas del usuario
  sesiones                     Sesion[]
  /// Citas médicas donde el usuario actúa como médico tratante
  citasMedico                  Cita[]                       @relation("CitaMedico")
  /// Historias clínicas creadas por este usuario
  historiales                  HistoriaClinica[]
  /// Registros de auditoría generados por acciones de este usuario
  auditLogs                    AuditLog[]
  /// Plantillas de formularios clínicos creadas por el usuario
  plantillasCreadas            PlantillaFormulario[]
  /// Triajes realizados por el usuario (en rol de enfermería)
  triajes                      Triaje[]                     @relation("TriajeEnfermera")
  /// Medicamentos registrados por este usuario
  medicamentosCreados          Medicamento[]                @relation("MedicamentoCreadoPor")
  /// Medicamentos actualizados por este usuario
  medicamentosActualizados     Medicamento[]                @relation("MedicamentoActualizadoPor")
  /// Medicamentos eliminados lógicamente por este usuario
  medicamentosEliminados       Medicamento[]                @relation("MedicamentoEliminadoPor")
  /// Pacientes eliminados lógicamente por este usuario
  pacientesEliminados          Paciente[]                   @relation("PacienteEliminadoPor")
  /// Citas registradas por este usuario
  citasCreadas                 Cita[]                       @relation("CitaCreadaPor")
  /// Citas canceladas por este usuario
  citasCanceladas              Cita[]                       @relation("CitaCanceladaPor")
  /// Historias clínicas actualizadas por este usuario
  historiasActualizadas        HistoriaClinica[]            @relation("HistoriaActualizadaPor")
  /// Historias clínicas eliminadas por este usuario
  historiasEliminadas          HistoriaClinica[]            @relation("HistoriaEliminadaPor")
  /// Establecimientos registrados por este usuario
  establecimientosCreados      Establecimiento[]            @relation("EstablecimientoCreadoPor")
  /// Establecimientos actualizados por este usuario
  establecimientosActualizados Establecimiento[]            @relation("EstablecimientoActualizadoPor")
  /// Establecimientos eliminados por este usuario
  establecimientosEliminados   Establecimiento[]            @relation("EstablecimientoEliminadoPor")
  /// Notificaciones epidemiológicas gestionadas por este usuario
  notificacionesGestionadas    NotificacionEpidemiologica[] @relation("GestionadoPor")
  /// Especialidades registradas por este usuario
  especialidadesCreadas        Especialidad[]               @relation("EspecialidadCreadaPor")
  /// Especialidades actualizadas por este usuario
  especialidadesActualizadas   Especialidad[]               @relation("EspecialidadActualizadaPor")
  /// Inventarios registrados por este usuario
  inventariosCreados           Inventario[]                 @relation("InventarioCreadoPor")
  /// Inventarios actualizados por este usuario
  inventariosActualizados      Inventario[]                 @relation("InventarioActualizadoPor")
  /// Inventarios eliminados por este usuario
  inventariosEliminados        Inventario[]                 @relation("InventarioEliminadoPor")
  /// Dispensaciones de medicamentos realizadas por este usuario
  dispensaciones               Dispensacion[]
  /// Configuraciones de agenda base para este médico
  agendasBase                  AgendaBase[]                 @relation("AgendaMedico")
  /// Excepciones a la agenda (vacaciones, permisos) de este médico
  excepcionesAgenda            ExcepcionAgenda[]            @relation("ExcepcionMedico")
  /// Registros de vacunas aplicadas por este usuario
  vacunasAplicadas             VacunacionRegistro[]
  /// Movimientos de inventario de vacunas realizados por este usuario
  movimientosVacunas           MovimientoVacuna[]
  /// Notificaciones epidemiológicas creadas por este usuario
  notificacionesCreadas        NotificacionEpidemiologica[] @relation("NotificacionCreadaPor")
  /// Ingresos hospitalarios autorizados por este médico
  ingresosAutorizados          IngresoHospitalario[]        @relation("MedicoIngreso")
  /// Egresos hospitalarios firmados por este médico
  egresosFirmados              EgresoHospitalario[]         @relation("MedicoEgreso")
  /// Notas de evolución realizadas por el médico
  notasEvolucion               NotaEvolucion[]
  kardexMedicamentos           KardexMedicamento[]
  controlSignosVitales         ControlSignosVitales[]
  /// Movimientos de inventario realizados por este usuario
  movimientosInventario        MovimientoInventario[]
  /// Solicitudes de usuario procesadas por este administrador
  solicitudesProcesadas        SolicitudUsuario[]           @relation("SolicitudesProcesadas")

  @@map("usuarios")
}

/// Representa las sesiones de autenticación activas mediante Refresh Tokens
model Sesion {
  /// Identificador único de la sesión
  id               Int      @id @default(autoincrement())
  /// ID del usuario dueño de la sesión
  usuarioId        Int
  /// Hash del Refresh Token almacenado para validación de seguridad
  refreshTokenHash String   @db.VarChar(255)
  /// Fecha de expiración del token
  expiresAt        DateTime
  /// Dirección IP desde la cual se inició la sesión
  ip               String?  @db.VarChar(45)
  /// User Agent del navegador/dispositivo que inició la sesión
  userAgent        String?  @db.VarChar(500)
  /// Fecha y hora de creación de la sesión
  creadaEn         DateTime @default(now())

  /// Relación con el usuario
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("sesiones")
}

// =============================================
// SOLICITUDES DE ACCESO
// =============================================

/// Representa una solicitud de creación de usuario desde la aplicación móvil
model SolicitudUsuario {
  /// Identificador único
  id                Int              @id @default(autoincrement())
  /// Documento Nacional de Identificación
  dni               String           @unique @db.VarChar(13)
  /// Nombres del solicitante
  nombres           String           @db.VarChar(100)
  /// Apellidos del solicitante
  apellidos         String           @db.VarChar(100)
  /// Correo electrónico para notificar resolución
  correo            String           @db.VarChar(150)
  /// Número de teléfono de contacto
  telefono          String?          @db.VarChar(20)
  /// Motivo o justificación de la solicitud
  justificacion     String?          @db.Text
  /// Estado de la solicitud (PENDIENTE, APROBADA, RECHAZADA)
  estado            EstadoSolicitud  @default(PENDIENTE)
  /// Observaciones del administrador al procesar
  observaciones     String?          @db.VarChar(500)
  /// Fecha de envío de la solicitud
  creadaEn          DateTime         @default(now())
  /// Fecha de resolución
  procesadaEn       DateTime?
  /// ID del usuario que procesó la solicitud
  procesadaPorId    Int?

  /// Relación con el usuario que procesó
  procesadaPor      Usuario?         @relation("SolicitudesProcesadas", fields: [procesadaPorId], references: [id])

  @@map("solicitudes_usuario")
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// =============================================
// ESTABLECIMIENTOS
// =============================================

/// Representa los centros de salud, hospitales y clínicas de la red de servicios
model Establecimiento {
  /// Identificador único autoincremental
  id               Int                 @id @default(autoincrement())
  /// Código institucional único (ej: HNT-001)
  codigo           String              @unique @db.VarChar(20)
  /// Nombre completo del establecimiento
  nombre           String              @db.VarChar(200)
  /// Nivel o tipo de establecimiento (Hospital, Centro de Salud, etc.)
  tipo             TipoEstablecimiento
  /// ID del departamento geográfico donde se ubica
  departamentoId   Int
  /// ID del municipio donde se ubica
  municipioId      Int
  /// Teléfono de contacto institucional
  telefono         String?             @db.VarChar(20)
  /// Indica si el establecimiento está operativo
  activo           Boolean             @default(true)
  /// Fecha de registro en el sistema
  creadoEn         DateTime            @default(now())
  /// Fecha de última actualización de datos
  actualizadoEn    DateTime?           @updatedAt
  /// Fecha de eliminación lógica (si aplica)
  eliminadoEn      DateTime?
  /// ID del usuario que registró el establecimiento
  creadoPorId      Int?
  /// ID del usuario que realizó la última actualización
  actualizadoPorId Int?
  /// ID del usuario que realizó la eliminación lógica
  eliminadoPorId   Int?

  /// Relación con el departamento
  departamento   Departamento @relation(fields: [departamentoId], references: [id])
  /// Relación con el municipio
  municipio      Municipio    @relation(fields: [municipioId], references: [id], map: "establecimientos_municipio_fkey_unique")
  /// Relación con el usuario creador
  creadoPor      Usuario?     @relation("EstablecimientoCreadoPor", fields: [creadoPorId], references: [id])
  /// Relación con el usuario actualizador
  actualizadoPor Usuario?     @relation("EstablecimientoActualizadoPor", fields: [actualizadoPorId], references: [id])
  /// Relación con el usuario eliminador
  eliminadoPor   Usuario?     @relation("EstablecimientoEliminadoPor", fields: [eliminadoPorId], references: [id])

  /// Usuarios asociados a este establecimiento
  usuarios          Usuario[]
  /// Pacientes registrados en este establecimiento
  pacientes         Paciente[]
  /// Citas programadas en este establecimiento
  citas             Cita[]
  /// Inventarios de farmacia de este establecimiento
  inventarios       Inventario[]
  /// Exámenes de laboratorio disponibles en este establecimiento
  laboratorios      ExamenEstablecimiento[]
  /// Estudios de radiología disponibles en este establecimiento
  radiologia        EstudioRadiologicoEstablecimiento[]
  /// Solicitudes de laboratorio realizadas desde/hacia este establecimiento
  solicitudesLab    SolicitudLaboratorio[]
  /// Solicitudes de radiología realizadas desde/hacia este establecimiento
  solicitudesRad    SolicitudRadiologia[]
  /// Servicios (unidades funcionales) habilitados en este establecimiento
  servicios         Servicio[]
  /// Referencias emitidas por este establecimiento
  referidosOrigen   Referido[]                          @relation("ReferidoOrigen")
  /// Referencias recibidas por este establecimiento
  referidosDestino  Referido[]                          @relation("ReferidoDestino")
  /// Personal asignado a este establecimiento
  asignaciones      AsignacionUsuario[]
  /// Recetas emitidas en este establecimiento
  recetas           Receta[]
  /// Dispensaciones realizadas en la farmacia de este establecimiento
  dispensaciones    Dispensacion[]
  /// Configuraciones de agenda base en este establecimiento
  agendasBase       AgendaBase[]
  /// Excepciones temporales a la agenda en este establecimiento
  excepcionesAgenda ExcepcionAgenda[]
  /// Lotes de vacunas almacenados en este establecimiento
  lotesVacunas      LoteVacuna[]
  /// Registros de vacunación aplicados en este establecimiento
  registrosVacunas  VacunacionRegistro[]

  @@map("establecimientos")
}

/// Clasificación oficial de establecimientos de salud en Honduras
enum TipoEstablecimiento {
  /// Hospital de referencia nacional
  HOSPITAL_NACIONAL
  /// Hospital departamental o regional
  HOSPITAL_REGIONAL
  /// Centro de salud con atención médica
  CENTRO_SALUD
  /// Clínica de atención de emergencias periférica
  CLINICA_PERIFERICA
  /// Centro de Salud con Médico y Odontólogo
  CESAMO
  /// Centro de Salud Rural
  CESAR
}

// =============================================
// SERVICIOS / UNIDADES FUNCIONALES
// =============================================

/// Catálogo maestro de servicios o unidades funcionales (ej: Emergencias, Farmacia)
model CatServicio {
  /// Identificador único
  id          Int        @id @default(autoincrement())
  /// Nombre único del servicio
  nombre      String     @unique @db.VarChar(100)
  /// Descripción de las funciones del servicio
  descripcion String?    @db.VarChar(300)
  /// Indica si el servicio está activo para ser asignado
  activo      Boolean    @default(true)
  /// Relación con las instancias de este servicio en diferentes establecimientos
  servicios   Servicio[]

  @@map("cat_servicios")
}

/// Registro de reportes analíticos disponibles en la plataforma
model ReporteDisponible {
  /// Identificador único
  id          Int     @id @default(autoincrement())
  /// Nombre legible del reporte
  nombre      String  @db.VarChar(100)
  /// Descripción de la utilidad y datos que contiene
  descripcion String? @db.VarChar(200)
  /// Categoría para agrupación en la UI (MEDICA, FARMACIA, etc.)
  categoria   String  @db.VarChar(50)
  /// Identificador interno para la lógica de generación
  slug        String  @unique @db.VarChar(50)
  /// Formato de salida (EXCEL, PDF)
  tipo        String  @db.VarChar(10)
  /// Permiso granular requerido para acceder a este reporte
  permiso     String  @db.VarChar(50)
  /// Nombre del icono decorativo en la UI
  icono       String? @db.VarChar(50)
  /// Indica si el reporte está disponible actualmente
  activo      Boolean @default(true)
  /// Orden de aparición en el listado
  orden       Int     @default(0)

  @@map("reportes_disponibles")
}

/// Representa la habilitación de un servicio del catálogo en un establecimiento específico
model Servicio {
  /// Identificador único
  id     Int     @id @default(autoincrement())
  /// Indica si el servicio está operativo en este establecimiento
  activo Boolean @default(true)

  /// ID del establecimiento
  establecimientoId Int
  /// ID del servicio del catálogo
  catServicioId     Int

  /// Relación con el establecimiento
  establecimiento Establecimiento       @relation(fields: [establecimientoId], references: [id])
  /// Relación con el catálogo de servicios
  catServicio     CatServicio           @relation(fields: [catServicioId], references: [id])
  /// Personal asignado específicamente a esta unidad funcional
  asignaciones    AsignacionUsuario[]
  /// Salas o pabellones pertenecientes a este servicio
  salas           Sala[]
  /// Ingresos hospitalarios admitidos en este servicio
  ingresos        IngresoHospitalario[]

  @@map("servicios")
}

// =============================================
// INFRAESTRUCTURA HOSPITALARIA
// =============================================

/// Catálogo maestro de tipos de habitaciones (ej: Privada, Bipersonal, Sala Común)
model CatTipoHabitacion {
  /// Identificador único
  id           Int          @id @default(autoincrement())
  /// Nombre del tipo de habitación
  nombre       String       @unique @db.VarChar(50)
  /// Descripción de las características
  descripcion  String?      @db.VarChar(200)
  /// Habitaciones de este tipo
  habitaciones Habitacion[]

  @@map("cat_tipos_habitacion")
}

/// Catálogo maestro de tipos de camas (ej: Cama Eléctrica, Camilla, Cuna, Incubadora)
model CatTipoCama {
  /// Identificador único
  id          Int     @id @default(autoincrement())
  /// Nombre del tipo de cama
  nombre      String  @unique @db.VarChar(50)
  /// Descripción técnica
  descripcion String? @db.VarChar(200)
  /// Camas de este tipo
  camas       Cama[]

  @@map("cat_tipos_cama")
}

/// Representa una sala o pabellón dentro de un servicio médico
model Sala {
  /// Identificador único
  id     Int     @id @default(autoincrement())
  /// Nombre descriptivo (ej: Sala de Hombres)
  nombre String  @db.VarChar(100)
  /// Código interno de la sala
  codigo String? @db.VarChar(20)
  /// Indica si la sala está activa
  activo Boolean @default(true)

  /// ID del servicio al que pertenece
  servicioId   Int
  /// Relación con el servicio
  servicio     Servicio     @relation(fields: [servicioId], references: [id])
  /// Habitaciones contenidas en la sala
  habitaciones Habitacion[]

  @@map("salas")
}

/// Representa una habitación o pieza física dentro de una sala
model Habitacion {
  /// Identificador único
  id     Int     @id @default(autoincrement())
  /// Número o nombre de la habitación (ej: 101, A-1)
  numero String  @db.VarChar(20)
  /// Indica si la habitación está operativa
  activo Boolean @default(true)

  /// ID de la sala a la que pertenece
  salaId           Int
  /// Relación con la sala
  sala             Sala              @relation(fields: [salaId], references: [id])
  /// ID del tipo de habitación
  tipoHabitacionId Int
  /// Relación con el catálogo de tipos de habitación
  tipoHabitacion   CatTipoHabitacion @relation(fields: [tipoHabitacionId], references: [id])
  /// Camas disponibles en esta habitación
  camas            Cama[]

  @@map("habitaciones")
}

/// Representa la unidad funcional final de hospitalización
model Cama {
  /// Identificador único
  id     Int        @id @default(autoincrement())
  /// Código único de identificación de la cama
  codigo String     @unique @db.VarChar(20)
  /// Estado actual de la cama
  estado EstadoCama @default(DISPONIBLE)
  /// Indica si la cama está activa físicamente
  activo Boolean    @default(true)

  /// ID de la habitación a la que pertenece
  habitacionId       Int
  /// Relación con la habitación
  habitacion         Habitacion               @relation(fields: [habitacionId], references: [id])
  /// ID del tipo de cama
  tipoCamaId         Int
  /// Relación con el catálogo de tipos de cama
  tipoCama           CatTipoCama              @relation(fields: [tipoCamaId], references: [id])
  /// Ingresos hospitalarios asociados a esta cama
  ingresos           IngresoHospitalario[]
  /// Movimientos donde esta cama fue el origen
  movimientosOrigen  MovimientoHospitalario[] @relation("CamaOrigen")
  /// Movimientos donde esta cama fue el destino
  movimientosDestino MovimientoHospitalario[] @relation("CamaDestino")

  @@map("camas")
}

/// Estados operativos posibles de una cama
enum EstadoCama {
  /// Lista para recibir paciente
  DISPONIBLE
  /// Con paciente asignado
  OCUPADA
  /// Apartada para un ingreso próximo
  RESERVADA
  /// Fuera de servicio por desperfecto
  MANTENIMIENTO
  /// En proceso de desinfección/limpieza
  LIMPIEZA
}

// =============================================
// ASIGNACIONES DE PERSONAL (MULTI-ESTABLECIMIENTO)
// =============================================

/// Permite la gestión de personal en múltiples establecimientos y servicios con roles diferenciados
model AsignacionUsuario {
  /// Identificador único
  id                Int      @id @default(autoincrement())
  /// ID del usuario asignado
  usuarioId         Int
  /// ID del establecimiento de la asignación
  establecimientoId Int
  /// ID del servicio (opcional) si la asignación es a una unidad funcional específica
  servicioId        Int?
  /// ID del rol (opcional) si el usuario tiene un rol distinto en este establecimiento
  rolId             Int?
  /// ID de la especialidad (opcional) si ejerce una especialidad distinta aquí
  especialidadId    Int?
  /// Indica si la asignación está vigente
  activo            Boolean  @default(true)
  /// Sobrescritura opcional de permisos específicos para esta asignación
  permisos          Json?
  /// Fecha de creación de la asignación
  creadoEn          DateTime @default(now())
  /// Fecha de última modificación
  actualizadoEn     DateTime @updatedAt

  /// Relación con el usuario
  usuario         Usuario         @relation(fields: [usuarioId], references: [id])
  /// Relación con el establecimiento
  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])
  /// Relación con el servicio específico
  servicio        Servicio?       @relation(fields: [servicioId], references: [id])
  /// Relación con el rol específico
  rol             Rol?            @relation(fields: [rolId], references: [id])
  /// Relación con la especialidad específica
  especialidad    Especialidad?   @relation(fields: [especialidadId], references: [id])

  @@unique([usuarioId, establecimientoId, servicioId, especialidadId])
  @@map("asignaciones_usuario")
}

// =============================================
// ESPECIALIDADES
// =============================================

/// Catálogo de especialidades médicas (ej: Pediatría, Ginecología)
model Especialidad {
  /// Identificador único
  id               Int       @id @default(autoincrement())
  /// Código abreviado de la especialidad (ej: PED, GIN)
  codigo           String    @unique @db.VarChar(20)
  /// Nombre completo de la especialidad
  nombre           String    @db.VarChar(100)
  /// Breve descripción del alcance de la especialidad
  descripcion      String?   @db.VarChar(300)
  /// Indica si la especialidad está activa para nuevas asignaciones
  activa           Boolean   @default(true)
  /// Fecha de registro
  creadoEn         DateTime  @default(now())
  /// Fecha de última actualización
  actualizadoEn    DateTime? @updatedAt
  /// ID del usuario que registró la especialidad
  creadoPorId      Int?
  /// ID del usuario que realizó la última actualización
  actualizadoPorId Int?

  /// Relación con el usuario creador
  creadoPor      Usuario?              @relation("EspecialidadCreadaPor", fields: [creadoPorId], references: [id])
  /// Relación con el usuario actualizador
  actualizadoPor Usuario?              @relation("EspecialidadActualizadaPor", fields: [actualizadoPorId], references: [id])
  /// Plantillas de formularios clínicos asociadas a esta especialidad
  plantillas     PlantillaFormulario[]
  /// Usuarios (médicos) que tienen esta especialidad como primaria
  usuarios       Usuario[]
  /// Asignaciones de personal donde se ejerce esta especialidad
  asignaciones   AsignacionUsuario[]
  /// Citas médicas programadas para esta especialidad
  citas          Cita[]

  @@map("especialidades")
}

// =============================================
// PACIENTES
// =============================================

/// Registro central de datos personales y demográficos de los pacientes
model Paciente {
  /// Identificador único autoincremental
  id                 Int       @id @default(autoincrement())
  /// Número de expediente único generado por el sistema
  numeroExpediente   String    @unique @db.VarChar(20)
  /// Documento Nacional de Identificación (Honduras)
  dni                String    @unique @db.VarChar(13)
  /// Nombres del paciente
  nombres            String    @db.VarChar(100)
  /// Apellidos del paciente
  apellidos          String    @db.VarChar(100)
  /// Fecha de nacimiento
  fechaNacimiento    DateTime  @db.Date
  /// ID del catálogo de sexos
  sexoId             Int
  /// ID del catálogo de tipos de sangre
  tipoSangreId       Int?
  /// Teléfono de contacto
  telefono           String?   @db.VarChar(20)
  /// Teléfono de contacto para emergencias
  telefonoEmergencia String?   @db.VarChar(20)
  /// Correo electrónico (opcional)
  correo             String?   @db.VarChar(150)
  /// Dirección de domicilio detallada
  direccion          String?   @db.VarChar(300)
  /// ID del departamento de domicilio
  departamentoId     Int
  /// ID del municipio de domicilio
  municipioId        Int
  /// Nombre de la comunidad, barrio o colonia
  comunidad          String?   @db.VarChar(100)
  /// ID del catálogo de escolaridad
  escolaridadId      Int?
  /// ID del catálogo de ocupaciones
  ocupacionId        Int?
  /// ID del catálogo de estado civil
  estadoCivilId      Int?
  /// Indica si el paciente está activo para atención
  activo             Boolean   @default(true)
  /// Fecha de registro inicial en el sistema
  fechaRegistro      DateTime  @default(now())
  /// Fecha de última actualización de datos demográficos
  actualizadoEn      DateTime? @updatedAt
  /// Fecha de eliminación lógica
  eliminadoEn        DateTime?
  /// ID del establecimiento donde se registró el paciente
  establecimientoId  Int
  /// ID del usuario que registró al paciente
  creadoPorId        Int
  /// ID del usuario que realizó la última actualización
  actualizadoPorId   Int?
  /// ID del usuario que realizó la eliminación lógica
  eliminadoPorId     Int?

  /// Relación con la cuenta de usuario móvil
  usuario            PacienteUsuario?

  /// Relación con el establecimiento de registro
  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])
  /// Relación con el departamento
  departamento    Departamento    @relation(fields: [departamentoId], references: [id])
  /// Relación con el municipio
  municipio       Municipio       @relation(fields: [municipioId], references: [id])
  /// Relación con el catálogo de sexos
  sexo            Sexo            @relation(fields: [sexoId], references: [id])
  /// Relación con el catálogo de tipos de sangre
  tipoSangre      TipoSangre?     @relation(fields: [tipoSangreId], references: [id])
  /// Relación con el catálogo de escolaridad
  escolaridad     Escolaridad?    @relation(fields: [escolaridadId], references: [id])
  /// Relación con el catálogo de ocupaciones
  ocupacion       Ocupacion?      @relation(fields: [ocupacionId], references: [id])
  /// Relación con el catálogo de estado civil
  estadoCivil     EstadoCivil?    @relation(fields: [estadoCivilId], references: [id])
  /// Relación con el usuario que eliminó el registro
  eliminadoPor    Usuario?        @relation("PacienteEliminadoPor", fields: [eliminadoPorId], references: [id])

  /// Historial de alergias del paciente
  alergias                      Alergia[]
  /// Historial de citas médicas
  citas                         Cita[]
  /// Historial de atenciones (Historia Clínica)
  historialClinico              HistoriaClinica[]
  /// Listado de medicamentos de uso crónico o actual
  medicamentosActivos           PacienteMedicamento[]
  /// Historial de triajes realizados
  triajes                       Triaje[]
  /// Historial de recetas emitidas
  recetas                       Receta[]
  /// Solicitudes de laboratorio realizadas
  solicitudesLab                SolicitudLaboratorio[]
  /// Solicitudes de radiología realizadas
  solicitudesRad                SolicitudRadiologia[]
  /// Historial de vacunación PAI
  vacunas                       VacunacionRegistro[]
  /// Notificaciones epidemiológicas asociadas al paciente
  notificacionesEpidemiologicas NotificacionEpidemiologica[]
  /// Historial de internamientos hospitalarios
  ingresos                      IngresoHospitalario[]

  @@map("pacientes")
}

// =============================================
// CATÃLOGOS NORMALIZADOS
// =============================================

/// Catálogo de sexos para registro demográfico
model Sexo {
  /// Identificador único
  id        Int        @id @default(autoincrement())
  /// Nombre del sexo (Masculino, Femenino)
  nombre    String     @unique @db.VarChar(20)
  /// Pacientes asociados a este sexo
  pacientes Paciente[]

  @@map("cat_sexos")
}

/// Catálogo de tipos de sangre y factor RH
model TipoSangre {
  /// Identificador único
  id        Int        @id @default(autoincrement())
  /// Nombre del tipo de sangre (ej: O+, A-)
  nombre    String     @unique @db.VarChar(20)
  /// Pacientes asociados a este tipo de sangre
  pacientes Paciente[]

  @@map("cat_tipos_sangre")
}

/// Catálogo de niveles de escolaridad alcanzados
model Escolaridad {
  /// Identificador único
  id        Int        @id @default(autoincrement())
  /// Nombre del nivel (ej: Primaria, Universitaria)
  nombre    String     @unique @db.VarChar(50)
  /// Pacientes con este nivel de escolaridad
  pacientes Paciente[]

  @@map("cat_escolaridades")
}

/// Catálogo de estados civiles
model EstadoCivil {
  /// Identificador único
  id        Int        @id @default(autoincrement())
  /// Nombre del estado (ej: Soltero, Casado)
  nombre    String     @unique @db.VarChar(30)
  /// Pacientes con este estado civil
  pacientes Paciente[]

  @@map("cat_estados_civiles")
}

/// Catálogo de ocupaciones o profesiones
model Ocupacion {
  /// Identificador único
  id        Int        @id @default(autoincrement())
  /// Nombre de la ocupación
  nombre    String     @unique @db.VarChar(100)
  /// Pacientes que ejercen esta ocupación
  pacientes Paciente[]

  @@map("cat_ocupaciones")
}

/// Registro de alergias conocidas de un paciente
model Alergia {
  /// Identificador único
  id          Int         @id @default(autoincrement())
  /// ID del paciente afectado
  pacienteId  Int
  /// Categoría de la alergia (Medicamento, Alimento, etc.)
  tipo        TipoAlergia
  /// Descripción de la sustancia y reacción
  descripcion String      @db.VarChar(300)
  /// Grado de peligrosidad de la alergia
  severidad   Severidad

  /// Relación con el paciente
  paciente Paciente @relation(fields: [pacienteId], references: [id])

  @@map("alergias")
}

/// Clasificación del tipo de alérgeno
enum TipoAlergia {
  /// Reacción a fármacos
  MEDICAMENTO
  /// Reacción a comidas
  ALIMENTO
  /// Reacción a factores del entorno
  AMBIENTAL
  /// Reacción específica al látex
  LATEX
  /// Otros tipos de alergias
  OTRO
}

/// Escala de severidad de la reacción alérgica
enum Severidad {
  /// Reacción leve, no compromete la vida
  LEVE
  /// Reacción que requiere tratamiento médico moderado
  MODERADA
  /// Reacción anafiláctica o de alto riesgo
  SEVERA
}

// =============================================
// CITAS MÃDICAS
// =============================================

/// Gestión de citas médicas y programación de consultas
model Cita {
  /// Identificador único
  id                Int        @id @default(autoincrement())
  /// ID del paciente que solicita la cita
  pacienteId        Int
  /// ID del médico asignado (opcional si es urgencia)
  medicoId          Int
  /// ID del establecimiento donde se realizará la cita
  establecimientoId Int
  /// Fecha y hora programada para la atención
  fechaHora         DateTime
  /// Tiempo estimado de duración del encuentro médico
  duracionMinutos   Int        @default(20)
  /// Tipo de atención solicitada
  tipo              TipoCita
  /// Estado actual de la cita (Programada, Atendida, etc.)
  estado            EstadoCita @default(PROGRAMADA)
  /// Motivo breve de la consulta
  motivo            String?    @db.VarChar(500)
  /// Observaciones adicionales
  notas             String?    @db.Text
  /// Fecha de registro de la cita
  creadaEn          DateTime   @default(now())
  /// ID del usuario (recepcionista) que registró la cita
  creadoPorId       Int?
  /// ID del usuario que canceló la cita (si aplica)
  canceladoPorId    Int?
  /// ID de la especialidad bajo la cual se atiende la cita
  especialidadId    Int?

  /// Relación con el paciente
  paciente        Paciente         @relation(fields: [pacienteId], references: [id])
  /// Relación con el médico tratante
  medico          Usuario          @relation("CitaMedico", fields: [medicoId], references: [id])
  /// Relación con el establecimiento
  establecimiento Establecimiento  @relation(fields: [establecimientoId], references: [id])
  /// Relación con el usuario creador
  creadoPor       Usuario?         @relation("CitaCreadaPor", fields: [creadoPorId], references: [id])
  /// Relación con el usuario que canceló
  canceladoPor    Usuario?         @relation("CitaCanceladaPor", fields: [canceladoPorId], references: [id])
  /// Relación con la especialidad
  especialidad    Especialidad?    @relation(fields: [especialidadId], references: [id])
  /// Historia clínica resultante de esta cita
  historia        HistoriaClinica?
  /// Datos de triaje previo a la consulta
  triaje          Triaje?
  /// Relación con la atención previa que originó esta cita (si fue una re-cita)
  historiaOrigen  HistoriaClinica? @relation("ProximaCita")

  @@map("citas")
}

/// Clasificación del tipo de encuentro médico
enum TipoCita {
  /// Consulta médica general
  CONSULTA_GENERAL
  /// Consulta con médico especialista
  ESPECIALIDAD
  /// Cita de seguimiento o control
  CONTROL
  /// Atención inmediata por urgencia
  URGENCIA
  /// Cita para aplicación de vacunas
  VACUNACION
  /// Consulta de salud reproductiva
  PLANIFICACION
}

/// Estados posibles en el ciclo de vida de una cita
enum EstadoCita {
  /// Cita registrada pero pendiente de confirmación/llegada
  PROGRAMADA
  /// El paciente ha confirmado su asistencia
  CONFIRMADA
  /// El encuentro médico ha concluido exitosamente
  ATENDIDA
  /// La cita ha sido anulada por el paciente o el centro
  CANCELADA
  /// El paciente no se presentó a su cita programada
  NO_ASISTIO
  /// El paciente está presente en el establecimiento esperando atención
  EN_SALA
}

// =============================================
// HISTORIA CLÃNICA
// =============================================

/// Representa el encuentro clínico (consulta) y el registro médico del paciente
model HistoriaClinica {
  /// Identificador único
  id          Int      @id @default(autoincrement())
  /// ID del paciente atendido
  pacienteId  Int
  /// ID del médico tratante
  medicoId    Int
  /// ID de la cita asociada
  citaId      Int?     @unique
  /// ID de la plantilla de formulario utilizada
  plantillaId Int?
  /// Fecha y hora de la atención
  fecha       DateTime @default(now())

  /// [S]ubjetivo: Motivo de consulta, síntomas y anamnesis
  subjetivo String @db.Text
  /// [O]bjetivo: Hallazgos del examen físico
  objetivo  String @db.Text
  /// [A]nálisis: Razonamiento médico y diagnósticos presuntivos
  analisis  String @db.Text
  /// [P]lan: Tratamiento, medicamentos, exámenes y recomendaciones
  plan      String @db.Text

  /// Tensión arterial sistólica (mmHg)
  presionSistolica     Int?
  /// Tensión arterial diastólica (mmHg)
  presionDiastolica    Int?
  /// Latidos por minuto
  frecuenciaCardiaca   Int?
  /// Temperatura corporal (Â°C)
  temperatura          Decimal? @db.Decimal(4, 1)
  /// Peso del paciente (kg)
  peso                 Decimal? @db.Decimal(5, 2)
  /// Estatura del paciente (cm)
  talla                Decimal? @db.Decimal(4, 1)
  /// Porcentaje de saturación de oxígeno
  saturacionO2         Int?
  /// Número de semana epidemiológica (1-52)
  semanaEpidemiologica Int?

  /// Fecha de la última modificación
  actualizadoEn    DateTime?
  /// Fecha de eliminación lógica
  eliminadoEn      DateTime?
  /// ID del usuario que actualizó el registro
  actualizadoPorId Int?
  /// ID del usuario que eliminó el registro
  eliminadoPorId   Int?

  /// Relación con el paciente
  paciente                   Paciente                    @relation(fields: [pacienteId], references: [id])
  /// Relación con el médico
  medico                     Usuario                     @relation(fields: [medicoId], references: [id])
  /// Relación con el usuario actualizador
  actualizadoPor             Usuario?                    @relation("HistoriaActualizadaPor", fields: [actualizadoPorId], references: [id])
  /// Relación con el usuario eliminador
  eliminadoPor               Usuario?                    @relation("HistoriaEliminadaPor", fields: [eliminadoPorId], references: [id])
  /// Relación con la cita
  cita                       Cita?                       @relation(fields: [citaId], references: [id])
  /// Relación con la plantilla de formulario
  plantilla                  PlantillaFormulario?        @relation(fields: [plantillaId], references: [id])
  /// ID de la próxima cita programada
  proximaCitaId              Int?                        @unique
  /// Relación con la próxima cita
  proximaCita                Cita?                       @relation("ProximaCita", fields: [proximaCitaId], references: [id])
  /// Listado de diagnósticos realizados en la consulta
  diagnosticos               Diagnostico[]
  /// Recetas emitidas
  recetas                    Receta[]
  /// Referencias emitidas
  referidos                  Referido[]
  /// Resultados de laboratorio asociados
  resultadosLab              ResultadoLaboratorio[]
  /// Solicitudes de laboratorio generadas
  solicitudesLab             SolicitudLaboratorio[]
  /// Solicitudes de radiología generadas
  solicitudesRad             SolicitudRadiologia[]
  /// Respuestas detalladas del formulario dinámico
  respuestaFormulario        RespuestaFormulario?
  /// Registro de incapacidades (si aplica)
  incapacidades              Incapacidad[]
  /// Notificación epidemiológica obligatoria
  notificacionEpidemiologica NotificacionEpidemiologica?

  @@map("historia_clinica")
}

/// Diagnósticos asociados a una atención médica (basados en CIE-10)
model Diagnostico {
  /// Identificador único
  id          Int             @id @default(autoincrement())
  /// ID de la historia clínica asociada
  historiaId  Int
  /// Código alfanumérico CIE-10
  codigoCIE10 String          @db.VarChar(10)
  /// Descripción del diagnóstico según catálogo
  descripcion String          @db.VarChar(500)
  /// Importancia del diagnóstico (Principal, Secundario)
  tipo        TipoDiagnostico

  /// Relación con la historia clínica
  historia HistoriaClinica @relation(fields: [historiaId], references: [id])

  @@map("diagnosticos")
}

/// Clasificación de la relevancia del diagnóstico
enum TipoDiagnostico {
  /// Causa principal de la consulta
  PRINCIPAL
  /// Patologías adicionales detectadas
  SECUNDARIO
  /// Enfermedades preexistentes relevantes
  COMORBILIDAD
}

/// Registro de incapacidades médicas otorgadas al paciente
model Incapacidad {
  /// Identificador único
  id          Int             @id @default(autoincrement())
  /// ID de la historia clínica asociada
  historiaId  Int
  /// Fecha de inicio del reposo
  fechaInicio DateTime        @db.Date
  /// Fecha de finalización del reposo
  fechaFin    DateTime        @db.Date
  /// Total de días de incapacidad
  dias        Int
  /// Ãmbito de la incapacidad (Laboral, Escolar)
  tipo        TipoIncapacidad @default(LABORAL)
  /// Descripción de la justificación médica
  motivo      String          @db.VarChar(500)

  /// Relación con la historia clínica
  historia HistoriaClinica @relation(fields: [historiaId], references: [id])

  @@map("incapacidades")
}

/// Tipo de justificación de ausencia
enum TipoIncapacidad {
  /// Reposo para trabajadores
  LABORAL
  /// Justificación para estudiantes
  ESCOLAR
  /// Recomendación para atletas
  DEPORTIVA
}

// =============================================
// FARMACIA
// =============================================

/// Catálogo maestro de medicamentos y productos farmacéuticos
model Medicamento {
  /// Identificador único
  id               Int               @id @default(autoincrement())
  /// Código de barras o SKU del medicamento
  codigo           String            @unique @db.VarChar(30)
  /// Denominación Común Internacional (DCI)
  nombreGenerico   String            @db.VarChar(200)
  /// Nombre bajo el cual se comercializa (opcional)
  nombreComercial  String?           @db.VarChar(200)
  /// Forma farmacéutica (ej: Tabletas, Jarabe)
  presentacion     String            @db.VarChar(100)
  /// Cantidad de principio activo (ej: 500mg)
  concentracion    String            @db.VarChar(50)
  /// Método de ingreso al organismo
  via              ViaAdministracion
  /// Clasificación terapéutica (ej: Antibióticos)
  grupoTerapeutico String            @db.VarChar(100)
  /// Indica si requiere autorización médica para dispensar
  requiereReceta   Boolean           @default(true)
  /// Indica si el medicamento es psicotrópico o estupefaciente
  esControlado     Boolean           @default(false)
  /// Indica si el medicamento está disponible en el catálogo
  activo           Boolean           @default(true)

  /// Fecha de registro inicial
  creadoEn         DateTime  @default(now())
  /// Fecha de última actualización de ficha técnica
  actualizadoEn    DateTime? @updatedAt
  /// Fecha de eliminación lógica
  eliminadoEn      DateTime?
  /// ID del usuario que registró el medicamento
  creadoPorId      Int?
  /// ID del usuario que realizó la última actualización
  actualizadoPorId Int?
  /// ID del usuario que realizó la eliminación lógica
  eliminadoPorId   Int?

  /// Relación con el usuario creador
  creadoPor      Usuario? @relation("MedicamentoCreadoPor", fields: [creadoPorId], references: [id])
  /// Relación con el usuario actualizador
  actualizadoPor Usuario? @relation("MedicamentoActualizadoPor", fields: [actualizadoPorId], references: [id])
  /// Relación con el usuario eliminador
  eliminadoPor   Usuario? @relation("MedicamentoEliminadoPor", fields: [eliminadoPorId], references: [id])

  /// Existencias de este medicamento en distintos establecimientos
  inventario         Inventario[]
  /// Apariciones de este medicamento en recetas emitidas
  detallesReceta     DetalleReceta[]
  kardexMedicamentos KardexMedicamento[]
  pacientesMedicamentos PacienteMedicamento[]

  @@map("medicamentos")
}

/// Listado de vías de administración de medicamentos
enum ViaAdministracion {
  /// Ingestión por la boca
  ORAL
  /// Administración mediante jeringas (IM, IV, SC)
  INYECTABLE
  /// Aplicación sobre la piel
  TOPICA
  /// Administración por vías respiratorias
  INHALATORIA
  /// Debajo de la lengua
  SUBLINGUAL
  /// Introducción por el recto
  RECTAL
  /// Aplicación en los ojos
  OFTALMICA
  /// Aplicación en los oídos
  OTICA
}

/// Control de existencias físicas de medicamentos por establecimiento y lote
model Inventario {
  /// Identificador único
  id                Int       @id @default(autoincrement())
  /// ID del medicamento asociado
  medicamentoId     Int
  /// ID del establecimiento que posee el stock
  establecimientoId Int
  /// Cantidad disponible actualmente para dispensar
  cantidadActual    Int       @default(0)
  /// Nivel mínimo antes de generar alertas de reabastecimiento
  cantidadMinima    Int       @default(10)
  /// Código del lote de fabricación para trazabilidad
  lote              String?   @db.VarChar(50)
  /// Fecha de expiración del lote
  fechaVencimiento  DateTime? @db.Date
  /// Ubicación física dentro de la bodega/farmacia
  ubicacion         String?   @db.VarChar(100)
  /// Indica si este stock está disponible para uso
  activo            Boolean   @default(true)
  /// Fecha de registro del ingreso inicial
  creadoEn          DateTime  @default(now())
  /// Fecha de último movimiento o ajuste
  actualizadoEn     DateTime? @updatedAt
  /// Fecha de eliminación (si aplica)
  eliminadoEn       DateTime?
  /// ID del usuario que registró el ingreso
  creadoPorId       Int?
  /// ID del usuario que realizó la última modificación
  actualizadoPorId  Int?
  /// ID del usuario que eliminó el registro
  eliminadoPorId    Int?

  /// Relación con la ficha del medicamento
  medicamento     Medicamento            @relation(fields: [medicamentoId], references: [id])
  /// Relación con el establecimiento de salud
  establecimiento Establecimiento        @relation(fields: [establecimientoId], references: [id])
  /// Relación con el usuario creador
  creadoPor       Usuario?               @relation("InventarioCreadoPor", fields: [creadoPorId], references: [id])
  /// Relación con el usuario actualizador
  actualizadoPor  Usuario?               @relation("InventarioActualizadoPor", fields: [actualizadoPorId], references: [id])
  /// Relación con el usuario eliminador
  eliminadoPor    Usuario?               @relation("InventarioEliminadoPor", fields: [eliminadoPorId], references: [id])
  /// Historial de entradas y salidas asociadas a este inventario
  movimientos     MovimientoInventario[]
  /// Detalles de dispensaciones realizadas desde este stock
  dispensaciones  DispensacionDetalle[]

  @@unique([medicamentoId, establecimientoId, lote])
  @@map("inventario")
}

/// Registro histórico de transacciones que afectan el stock de medicamentos
model MovimientoInventario {
  /// Identificador único
  id           Int            @id @default(autoincrement())
  /// ID del registro de inventario afectado
  inventarioId Int
  /// Tipo de transacción (Entrada, Salida, etc.)
  tipo         TipoMovimiento
  /// Cantidad de unidades involucradas en el movimiento
  cantidad     Int
  /// Explicación del porqué del movimiento
  motivo       String?        @db.VarChar(200)
  /// ID del usuario que realizó la transacción
  usuarioId    Int
  /// Fecha y hora del registro
  fecha        DateTime       @default(now())

  /// Relación con el inventario
  inventario Inventario @relation(fields: [inventarioId], references: [id])
  /// Relación con el usuario que realizó el movimiento
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])

  @@map("movimientos_inventario")
}

/// Clasificación de transacciones de inventario
enum TipoMovimiento {
  /// Ingreso de nuevo stock por compras o donaciones
  ENTRADA
  /// Salida por traslados o suministros internos
  SALIDA
  /// Correcciones manuales por inventario físico
  AJUSTE
  /// Eliminación por fecha de vencimiento alcanzada
  CADUCADO
  /// Salida por daño, robo o extravío
  PERDIDA
  /// Entrega directa al paciente mediante receta
  DISPENSACION
}

/// Documento de prescripción médica para un paciente
model Receta {
  /// Identificador único
  id                Int          @id @default(autoincrement())
  /// ID de la historia clínica donde se originó la receta
  historiaId        Int
  /// ID del paciente beneficiario
  pacienteId        Int
  /// ID del establecimiento donde se emitió
  establecimientoId Int
  /// Estado actual del flujo de dispensación
  estado            EstadoReceta @default(PENDIENTE)
  /// Fecha de emisión
  creadaEn          DateTime     @default(now())
  /// Fecha en la que se completó la entrega total
  dispensadaEn      DateTime?

  /// Relación con la historia clínica
  historia        HistoriaClinica @relation(fields: [historiaId], references: [id])
  /// Relación con el paciente
  paciente        Paciente        @relation(fields: [pacienteId], references: [id])
  /// Relación con el establecimiento
  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])
  /// Listado de medicamentos prescritos
  detalles        DetalleReceta[]
  /// Historial de entregas asociadas a esta receta
  dispensaciones  Dispensacion[]

  @@map("recetas")
}

/// Ciclo de vida de una receta médica
enum EstadoReceta {
  /// Receta emitida pero aún no presentada en farmacia
  PENDIENTE
  /// Se han entregado todos los medicamentos prescritos
  DISPENSADA
  /// Se han entregado solo algunos medicamentos o cantidades
  PARCIAL
  /// Receta anulada por el médico
  CANCELADA
  /// No se pudo dispensar por falta de existencias (stock agotado)
  DEMANDA_INSATISFECHA
}

/// Especificación de un medicamento individual dentro de una receta
model DetalleReceta {
  /// Identificador único
  id                 Int       @id @default(autoincrement())
  /// ID de la receta a la que pertenece
  recetaId           Int
  /// ID del medicamento prescrito
  medicamentoId      Int
  /// Cantidad y unidad por toma (ej: 1 tableta)
  dosis              String    @db.VarChar(100)
  /// Intervalo de tiempo (ej: Cada 8 horas)
  frecuencia         String    @db.VarChar(100)
  /// Tiempo total de tratamiento (ej: 7 días)
  duracion           String    @db.VarChar(100)
  /// Cantidad total de unidades a dispensar
  cantidad           Int
  /// Acumulado de unidades ya entregadas
  cantidadEntregada  Int       @default(0)
  /// Fecha del último despacho parcial
  ultimaDispensacion DateTime?
  /// Consejos adicionales para el paciente
  indicaciones       String?   @db.VarChar(500)

  /// Relación con la receta cabecera
  receta         Receta                @relation(fields: [recetaId], references: [id])
  /// Relación con la ficha del medicamento
  medicamento    Medicamento           @relation(fields: [medicamentoId], references: [id])
  /// Relación con los despachos físicos realizados
  dispensaciones DispensacionDetalle[]

  @@map("detalles_receta")
}

/// Historial de medicación activa (tratamientos crónicos) de un paciente
model PacienteMedicamento {
  /// Identificador único
  id            Int       @id @default(autoincrement())
  /// ID del paciente
  pacienteId    Int
  /// ID del medicamento
  medicamentoId Int
  /// Dosis del tratamiento
  dosis         String    @db.VarChar(100)
  /// Frecuencia de administración
  frecuencia    String    @db.VarChar(100)
  /// Fecha de inicio del tratamiento
  inicio        DateTime  @db.Date
  /// Fecha estimada de finalización (null si es permanente)
  fin           DateTime? @db.Date

  /// Relación con el paciente
  paciente    Paciente    @relation(fields: [pacienteId], references: [id])
  /// Relación con el catálogo de medicamentos
  medicamento Medicamento @relation(fields: [medicamentoId], references: [id])

  @@map("paciente_medicamentos")
}

