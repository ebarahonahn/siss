}

/// Representa una habitaciÃ³n o pieza fÃ­sica dentro de una sala
model Habitacion {
  /// Identificador Ãºnico
  id     Int     @id @default(autoincrement())
  /// NÃºmero o nombre de la habitaciÃ³n (ej: 101, A-1)
  numero String  @db.VarChar(20)
