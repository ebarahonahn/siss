/// Representa la unidad funcional final de hospitalizaciÃ³n
model Cama {
  /// Identificador Ãºnico
  id     Int        @id @default(autoincrement())
  /// CÃ³digo Ãºnico de identificaciÃ³n de la cama
  codigo String     @unique @db.VarChar(20)
  /// Estado actual de la cama
  estado EstadoCama @default(DISPONIBLE)
  /// Indica si la cama estÃ¡ activa fÃ­sicamente
  activo Boolean    @default(true)

  /// ID de la habitaciÃ³n a la que pertenece
  habitacionId       Int
  /// RelaciÃ³n con la habitaciÃ³n
  habitacion         Habitacion               @relation(fields: [habitacionId], references: [id])
  /// ID del tipo de cama
  tipoCamaId         Int
  /// RelaciÃ³n con el catÃ¡logo de tipos de cama
  tipoCama           CatTipoCama              @relation(fields: [tipoCamaId], references: [id])
  /// Ingresos hospitalarios asociados a esta cama
  ingresos           IngresoHospitalario[]
  /// Movimientos donde esta cama fue el origen
  movimientosOrigen  MovimientoHospitalario[] @relation("CamaOrigen")
  /// Movimientos donde esta cama fue el destino
  movimientosDestino MovimientoHospitalario[] @relation("CamaDestino")

  @@map("camas")
}

/// Estados operativos posibles de una cama
enum EstadoCama {
  /// Lista para recibir paciente
  DISPONIBLE
  /// Con paciente asignado
  OCUPADA
  /// Apartada para un ingreso prÃ³ximo
  RESERVADA
  /// Fuera de servicio por desperfecto
  MANTENIMIENTO
  /// En proceso de desinfecciÃ³n/limpieza
  LIMPIEZA
}

// =============================================
// ASIGNACIONES DE PERSONAL (MULTI-ESTABLECIMIENTO)
// =============================================

/// Permite la gestiÃ³n de personal en mÃºltiples establecimientos y servicios con roles diferenciados
model AsignacionUsuario {
  /// Identificador Ãºnico
  id                Int      @id @default(autoincrement())
  /// ID del usuario asignado
  usuarioId         Int
  /// ID del establecimiento de la asignaciÃ³n
  establecimientoId Int
  /// ID del servicio (opcional) si la asignaciÃ³n es a una unidad funcional especÃ­fica
  servicioId        Int?
  /// ID del rol (opcional) si el usuario tiene un rol distinto en este establecimiento
  rolId             Int?
  /// ID de la especialidad (opcional) si ejerce una especialidad distinta aquÃ­
  especialidadId    Int?
  /// Indica si la asignaciÃ³n estÃ¡ vigente
  activo            Boolean  @default(true)
  /// Sobrescritura opcional de permisos especÃ­ficos para esta asignaciÃ³n
  permisos          Json?
  /// Fecha de creaciÃ³n de la asignaciÃ³n
  creadoEn          DateTime @default(now())
  /// Fecha de Ãºltima modificaciÃ³n
  actualizadoEn     DateTime @updatedAt

  /// RelaciÃ³n con el usuario
  usuario         Usuario         @relation(fields: [usuarioId], references: [id])
  /// RelaciÃ³n con el establecimiento
  establecimiento Establecimiento @relation(fields: [establecimientoId], references: [id])
  /// RelaciÃ³n con el servicio especÃ­fico
  servicio        Servicio?       @relation(fields: [servicioId], references: [id])
  /// RelaciÃ³n con el rol especÃ­fico
  rol             Rol?            @relation(fields: [rolId], references: [id])
  /// RelaciÃ³n con la especialidad especÃ­fica
  especialidad    Especialidad?   @relation(fields: [especialidadId], references: [id])

  @@unique([usuarioId, establecimientoId, servicioId, especialidadId])
  @@map("asignaciones_usuario")
}

