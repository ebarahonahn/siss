/// Representa los centros de salud, hospitales y clÃ­nicas de la red de servicios
model Establecimiento {
  /// Identificador Ãºnico autoincremental
  id               Int                 @id @default(autoincrement())
  /// CÃ³digo institucional Ãºnico (ej: HNT-001)
  codigo           String              @unique @db.VarChar(20)
  /// Nombre completo del establecimiento
  nombre           String              @db.VarChar(200)
  /// Nivel o tipo de establecimiento (Hospital, Centro de Salud, etc.)
  tipo             TipoEstablecimiento
  /// ID del departamento geogrÃ¡fico donde se ubica
  departamentoId   Int
  /// ID del municipio donde se ubica
  municipioId      Int
  /// TelÃ©fono de contacto institucional
  telefono         String?             @db.VarChar(20)
  /// Indica si el establecimiento estÃ¡ operativo
  activo           Boolean             @default(true)
  /// Fecha de registro en el sistema
  creadoEn         DateTime            @default(now())
  /// Fecha de Ãºltima actualizaciÃ³n de datos
  actualizadoEn    DateTime?           @updatedAt
  /// Fecha de eliminaciÃ³n lÃ³gica (si aplica)
  eliminadoEn      DateTime?
  /// ID del usuario que registrÃ³ el establecimiento
  creadoPorId      Int?
  /// ID del usuario que realizÃ³ la Ãºltima actualizaciÃ³n
  actualizadoPorId Int?
  /// ID del usuario que realizÃ³ la eliminaciÃ³n lÃ³gica
  eliminadoPorId   Int?

  /// RelaciÃ³n con el departamento
  departamento   Departamento @relation(fields: [departamentoId], references: [id])
  /// RelaciÃ³n con el municipio
  municipio      Municipio    @relation(fields: [municipioId], references: [id], map: "establecimientos_municipio_fkey_unique")
  /// RelaciÃ³n con el usuario creador
  creadoPor      Usuario?     @relation("EstablecimientoCreadoPor", fields: [creadoPorId], references: [id])
  /// RelaciÃ³n con el usuario actualizador
  actualizadoPor Usuario?     @relation("EstablecimientoActualizadoPor", fields: [actualizadoPorId], references: [id])
  /// RelaciÃ³n con el usuario eliminador
  eliminadoPor   Usuario?     @relation("EstablecimientoEliminadoPor", fields: [eliminadoPorId], references: [id])

  /// Usuarios asociados a este establecimiento
  usuarios          Usuario[]
  /// Pacientes registrados en este establecimiento
  pacientes         Paciente[]
  /// Citas programadas en este establecimiento
  citas             Cita[]
  /// Inventarios de farmacia de este establecimiento
  inventarios       Inventario[]
  /// ExÃ¡menes de laboratorio disponibles en este establecimiento
  laboratorios      ExamenEstablecimiento[]
  /// Estudios de radiologÃ­a disponibles en este establecimiento
  radiologia        EstudioRadiologicoEstablecimiento[]
  /// Solicitudes de laboratorio realizadas desde/hacia este establecimiento
  solicitudesLab    SolicitudLaboratorio[]
  /// Solicitudes de radiologÃ­a realizadas desde/hacia este establecimiento
  solicitudesRad    SolicitudRadiologia[]
  /// Servicios (unidades funcionales) habilitados en este establecimiento
  servicios         Servicio[]
  /// Referencias emitidas por este establecimiento
  referidosOrigen   Referido[]                          @relation("ReferidoOrigen")
  /// Referencias recibidas por este establecimiento
  referidosDestino  Referido[]                          @relation("ReferidoDestino")
  /// Personal asignado a este establecimiento
  asignaciones      AsignacionUsuario[]
  /// Recetas emitidas en este establecimiento
  recetas           Receta[]
  /// Dispensaciones realizadas en la farmacia de este establecimiento
  dispensaciones    Dispensacion[]
  /// Configuraciones de agenda base en este establecimiento
  agendasBase       AgendaBase[]
  /// Excepciones temporales a la agenda en este establecimiento
  excepcionesAgenda ExcepcionAgenda[]
  /// Lotes de vacunas almacenados en este establecimiento
  lotesVacunas      LoteVacuna[]
  /// Registros de vacunaciÃ³n aplicados en este establecimiento
  registrosVacunas  VacunacionRegistro[]

  @@map("establecimientos")
}

/// ClasificaciÃ³n oficial de establecimientos de salud en Honduras
enum TipoEstablecimiento {
  /// Hospital de referencia nacional
  HOSPITAL_NACIONAL
  /// Hospital departamental o regional
  HOSPITAL_REGIONAL
  /// Centro de salud con atenciÃ³n mÃ©dica
  CENTRO_SALUD
  /// ClÃ­nica de atenciÃ³n de emergencias perifÃ©rica
  CLINICA_PERIFERICA
  /// Centro de Salud con MÃ©dico y OdontÃ³logo
  CESAMO
  /// Centro de Salud Rural
  CESAR
}

