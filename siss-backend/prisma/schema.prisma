/// CatÃ¡logo maestro de servicios o unidades funcionales (ej: Emergencias, Farmacia)
model CatServicio {
  /// Identificador Ãºnico
  id          Int        @id @default(autoincrement())
  /// Nombre Ãºnico del servicio
  nombre      String     @unique @db.VarChar(100)
  /// DescripciÃ³n de las funciones del servicio
  descripcion String?    @db.VarChar(300)
  /// Indica si el servicio estÃ¡ activo para ser asignado
  activo      Boolean    @default(true)
  /// RelaciÃ³n con las instancias de este servicio en diferentes establecimientos
  servicios   Servicio[]

  @@map("cat_servicios")
}

/// Registro de reportes analÃ­ticos disponibles en la plataforma
model ReporteDisponible {
  /// Identificador Ãºnico
  id          Int     @id @default(autoincrement())
  /// Nombre legible del reporte
  nombre      String  @db.VarChar(100)
  /// DescripciÃ³n de la utilidad y datos que contiene
  descripcion String? @db.VarChar(200)
  /// CategorÃ­a para agrupaciÃ³n en la UI (MEDICA, FARMACIA, etc.)
  categoria   String  @db.VarChar(50)
