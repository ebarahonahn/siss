/// Registro central de datos personales y demogrÃ¡ficos de los pacientes
model Paciente {
  /// Identificador Ãºnico autoincremental
  id                 Int       @id @default(autoincrement())
  /// NÃºmero de expediente Ãºnico generado por el sistema
  numeroExpediente   String    @unique @db.VarChar(20)
  /// Documento Nacional de IdentificaciÃ³n (Honduras)
